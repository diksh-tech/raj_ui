load_dotenv()
logger = logging.getLogger("FlightOps.MCPClient")
logging.basicConfig(level=os.getenv("LOG_LEVEL", "INFO"))

MCP_SERVER_URL = os.getenv("MCP_SERVER_URL", "http://127.0.0.1:8000").rstrip("/")
AZURE_OPENAI_KEY = os.getenv("AZURE_OPENAI_KEY")
AZURE_OPENAI_ENDPOINT = os.getenv("AZURE_OPENAI_ENDPOINT")
AZURE_OPENAI_DEPLOYMENT = os.getenv("AZURE_OPENAI_DEPLOYMENT", "gpt-4o")
AZURE_API_VERSION = os.getenv("AZURE_API_VERSION", "2024-12-01-preview")

if not AZURE_OPENAI_KEY:
    raise RuntimeError("AZURE_OPENAI_KEY not set in environment")

client_azure = AzureOpenAI(
    api_key=AZURE_OPENAI_KEY,
    api_version=AZURE_API_VERSION,
    azure_endpoint=AZURE_OPENAI_ENDPOINT
)

# Simple TOOLS registry example placeholder (if you need)
try:
    from tool_registry import TOOLS  # optional; your project may have this
except Exception:
    TOOLS = {}

# -- System prompts (same as your original) --
SYSTEM_PROMPT_PLAN = os.getenv("SYSTEM_PROMPT_PLAN", """
You are an assistant that converts user questions into MCP tool calls.
... (use the longer prompt from your earlier code if needed)
""")

SYSTEM_PROMPT_SUMMARIZE = os.getenv("SYSTEM_PROMPT_SUMMARIZE", """
You are an assistant that summarizes tool outputs into a concise answer.
""")

# Helper chunker
def chunk_text(text, size=120):
    words = text.split()
    cur = ""
    for w in words:
        if len(cur) + len(w) + 1 > size:
            yield cur.strip()
            cur = w
        else:
            cur = (cur + " " + w).strip()
    if cur:
        yield cur.strip()

class FlightOpsMCPClient:
    def __init__(self, base_url: str = None):
        self.base_url = (base_url or MCP_SERVER_URL).rstrip("/")
        self.session = None
        self._client_context = None

    async def connect(self):
        logger.info(f"Connecting to MCP at {self.base_url}")
        self._client_context = streamablehttp_client(self.base_url)
        read_stream, write_stream, _ = await self._client_context.__aenter__()
        self.session = ClientSession(read_stream, write_stream)
        await self.session.__aenter__()
        await self.session.initialize()
        logger.info("Connected to MCP server")

    async def disconnect(self):
        try:
            if self.session:
                await self.session.__aexit__(None, None, None)
            if self._client_context:
                await self._client_context.__aexit__(None, None, None)
            logger.info("Disconnected from MCP")
        except Exception as e:
            logger.exception("Error disconnecting MCP client")

    # Synchronous Azure call wrapper (keeps same API you had)
    def _call_azure_openai(self, messages: list, temperature: float = 0.2, max_tokens: int = 2048) -> str:
        try:
            completion = client_azure.chat.completions.create(
                model=AZURE_OPENAI_DEPLOYMENT,
                messages=messages,
                temperature=temperature,
                max_tokens=max_tokens,
            )
            return completion.choices[0].message.content
        except Exception as e:
            logger.error(f"Azure OpenAI error: {e}")
            return json.dumps({"error": str(e)})

    async def list_tools(self):
        if not self.session:
            await self.connect()
        tools_list = await self.session.list_tools()
        return tools_list

    async def invoke_tool(self, tool_name: str, args: dict):
        if not self.session:
            await self.connect()
        logger.info(f"Invoking tool {tool_name} with args {args}")
        result = await self.session.call_tool(tool_name, args)
        # Try to extract useful content defensively
        try:
            if hasattr(result, "data"):
                return result.data
            if hasattr(result, "content"):
                return result.content
            return result
        except Exception:
            return result

    # --- New: run_query with on_event callback for streaming ---
    async def run_query(self, user_query: str, on_event: Callable[[str, dict], Any] = None):
        """
        Plans tools (synchronously via Azure), executes them via MCP (await), and calls on_event(event_name, payload)
        at interesting moments so the caller (FastAPI) can stream SSE.
        """
        run_id = f"run-{uuid4().hex[:8]}"
        if on_event:
            await _maybe_call(on_event, "RUN_STARTED", {"run_id": run_id})

        # 1) Planning (LLM synchronous call)
        if on_event:
            await _maybe_call(on_event, "THINKING", {"run_id": run_id, "stage": "planning"})
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT_PLAN},
            {"role": "user", "content": user_query}
        ]
        plan_raw = self._call_azure_openai(messages, temperature=0.1)
        # Try to parse JSON plan (defensive)
        plan = []
        try:
            cleaned = plan_raw.strip().strip("`")
            if cleaned.lower().startswith("json"):
                cleaned = cleaned[4:].strip()
            plan_obj = json.loads(cleaned)
            plan = plan_obj.get("plan", []) if isinstance(plan_obj, dict) else (plan_obj if isinstance(plan_obj, list) else [])
        except Exception:
            logger.warning("LLM plan parse failed, sending raw as text plan")
            # fallback: ask LLM for a single tool suggestion (not ideal)
            plan = []

        # notify plan readiness
        if on_event:
            await _maybe_call(on_event, "STATE_DELTA", {"run_id": run_id, "stage": "plan_ready", "plan_length": len(plan)})

        results = []
        # Execute plan sequentially (stream tool events)
        for idx, step in enumerate(plan):
            tool = step.get("tool")
            args = step.get("arguments", {})
            if on_event:
                await _maybe_call(on_event, "TOOL_CALL_START", {"run_id": run_id, "tool": tool, "step": idx})
                await _maybe_call(on_event, "TOOL_CALL_ARGS", {"run_id": run_id, "tool": tool, "args": args})
            try:
                resp = await self.invoke_tool(tool, args)
                results.append({tool: resp})
                if on_event:
                    await _maybe_call(on_event, "TOOL_CALL_RESULT", {"run_id": run_id, "tool": tool, "result": resp})
            except Exception as e:
                logger.exception("Tool invocation failed")
                if on_event:
                    await _maybe_call(on_event, "RUN_ERROR", {"run_id": run_id, "error": str(e)})
                results.append({tool: {"error": str(e)}})

            # progress update
            if on_event:
                await _maybe_call(on_event, "STATE_DELTA", {"run_id": run_id, "progress": int((idx+1)/max(1,len(plan))*100)})

        # Summarize results (LLM)
        if on_event:
            await _maybe_call(on_event, "THINKING", {"run_id": run_id, "stage": "summarizing"})
        try:
            summary = self.summarize_results(user_query, plan, results).get("summary", "")
        except Exception:
            summary = "Summary generation failed."

        # stream summary in chunks
        if on_event:
            await _maybe_call(on_event, "TEXT_MESSAGE_START", {"run_id": run_id, "message_id": "msg1"})
            for chunk in chunk_text(summary, size=120):
                await _maybe_call(on_event, "TEXT_MESSAGE_CONTENT", {"run_id": run_id, "delta": chunk})
                await asyncio.sleep(0.02)
            await _maybe_call(on_event, "TEXT_MESSAGE_END", {"run_id": run_id, "message_id": "msg1"})

        if on_event:
            await _maybe_call(on_event, "RUN_FINISHED", {"run_id": run_id})

        return {"run_id": run_id, "plan": plan, "results": results, "summary": summary}

    # Summarizer uses Azure (same as your earlier method)
    def summarize_results(self, user_query: str, plan: list, results: list) -> dict:
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT_SUMMARIZE},
            {"role": "user", "content": f"Question:\n{user_query}"},
            {"role": "assistant", "content": f"Plan:\n{json.dumps(plan, indent=2)}"},
            {"role": "assistant", "content": f"Results:\n{json.dumps(results, indent=2)}"},
        ]
        summary = self._call_azure_openai(messages, temperature=0.3)
        return {"summary": summary}

# helper to call event (supports sync/async callbacks)
async def _maybe_call(cb, name, payload):
    try:
        res = cb(name, payload)
        if asyncio.iscoroutine(res):
            await res
    except Exception as e:
        logger.exception("on_event callback failed")
