import React, { useState, useRef } from "react";
import { parseSSEChunks } from "./sseHelpers";

const BACKEND_URL = import.meta.env.VITE_BACKEND_URL || "http://127.0.0.1:8001/get_data";

export default function App() {
  const [query, setQuery] = useState("");
  const [transcript, setTranscript] = useState("");
  const [isThinking, setIsThinking] = useState(false);
  const [progress, setProgress] = useState(null);
  const [toolLogs, setToolLogs] = useState([]);
  const [runId, setRunId] = useState(null);
  const [showConfirm, setShowConfirm] = useState(null);
  const controllerRef = useRef(null);

  function appendTranscriptText(text) {
    setTranscript(prev => prev + text);
  }

  function pushToolLog(log) {
    setToolLogs(prev => [log, ...prev].slice(0, 200));
  }

  function handleCustomEvent(payload) {
    if (payload.type === "confirm_action") {
      setShowConfirm({ message: payload.message, options: payload.options || ["yes","no"], payload });
    } else {
      pushToolLog({ type: "custom", content: JSON.stringify(payload) });
    }
  }

  async function startRun() {
    if (!query.trim()) return;
    setTranscript("");
    setToolLogs([]);
    setProgress(null);
    setIsThinking(true);
    setRunId(null);
    setShowConfirm(null);

    if (controllerRef.current) {
      controllerRef.current.abort();
      controllerRef.current = null;
    }
    const controller = new AbortController();
    controllerRef.current = controller;

    try {
      const res = await fetch(BACKEND_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userprompt: query }),
        signal: controller.signal,
      });

      if (!res.ok) {
        const text = await res.text();
        pushToolLog({ type: "error", content: `HTTP ${res.status}: ${text}` });
        setIsThinking(false);
        return;
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder("utf-8");
      let buffer = "";
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const [chunks, rest] = parseSSEChunks(buffer);
        buffer = rest;
        for (const chunk of chunks) {
          const { event, data } = chunk;
          handleEvent(event, data);
        }
      }
    } catch (err) {
      if (err.name === "AbortError") {
        pushToolLog({ type: "info", content: "Stream aborted by user." });
      } else {
        pushToolLog({ type: "error", content: `Stream error: ${err.message}` });
      }
    } finally {
      setIsThinking(false);
      controllerRef.current = null;
    }
  }

  function handleEvent(eventName, payload) {
    const p = (payload && payload.payload) ? payload.payload : payload;

    switch (eventName) {
      case "RUN_STARTED":
        setRunId(p.run_id || p.runId || null);
        pushToolLog({ type: "lifecycle", content: `Run started: ${p.run_id || p.runId || ""}` });
        break;
      case "THINKING":
        setIsThinking(true);
        pushToolLog({ type: "thinking", content: p.note || p.stage || JSON.stringify(p) });
        break;
      case "STATE_DELTA":
        if (p.progress !== undefined) setProgress(Math.round(p.progress));
        pushToolLog({ type: "state", content: JSON.stringify(p) });
        break;
      case "TOOL_CALL_START":
        pushToolLog({ type: "tool-start", tool: p.tool, content: JSON.stringify(p) });
        break;
      case "TOOL_CALL_ARGS":
        pushToolLog({ type: "tool-args", tool: p.tool, content: JSON.stringify(p) });
        break;
      case "TOOL_CALL_RESULT":
        pushToolLog({ type: "tool-result", tool: p.tool, content: (p.result || p.content || JSON.stringify(p)).toString() });
        break;
      case "TEXT_MESSAGE_CONTENT":
        if (p.delta) appendTranscriptText(p.delta);
        else appendTranscriptText(JSON.stringify(p));
        break;
      case "TEXT_MESSAGE_START":
        pushToolLog({ type: "text-start", content: `Assistant started replying` });
        break;
      case "TEXT_MESSAGE_END":
        pushToolLog({ type: "text-end", content: "Assistant finished message" });
        break;
      case "RUN_FINISHED":
        pushToolLog({ type: "lifecycle", content: "Run finished" });
        setIsThinking(false);
        break;
      case "RUN_ERROR":
        pushToolLog({ type: "error", content: p.error || JSON.stringify(p) });
        setIsThinking(false);
        break;
      case "CUSTOM_EVENT":
        handleCustomEvent(p);
        break;
      default:
        pushToolLog({ type: "unknown", content: `${eventName} ${JSON.stringify(p)}` });
    }
  }

  function cancelRun() {
    if (controllerRef.current) controllerRef.current.abort();
  }

  return (
    <div className="app">
      <header>
        <h1>FlightOps Assistant — Indigo (Deeksha)</h1>
      </header>

      <main>
        <section className="controls">
          <textarea value={query} onChange={e=>setQuery(e.target.value)} placeholder="Type flight query, e.g. '6E 215 status today'"></textarea>
          <div className="buttons">
            <button onClick={startRun} disabled={isThinking}>Ask</button>
            <button onClick={cancelRun} disabled={!isThinking}>Cancel</button>
          </div>
        </section>

        <section className="stream">
          <div className="meta">
            {isThinking ? <span className="badge thinking">Thinking…</span> : <span className="badge idle">Idle</span>}
            {progress !== null && <span className="badge">Progress: {progress}%</span>}
            {runId && <span className="badge">run: {runId}</span>}
          </div>

          <div className="transcript">
            <h3>Assistant</h3>
            <div className="streaming-text">{transcript || <i>Waiting for response…</i>}</div>
          </div>

          <div className="tool-logs">
            <h4>Events / Tool logs</h4>
            <ul>
              {toolLogs.map((t, idx) => (
                <li key={idx} className={`log ${t.type}`}>
                  <strong>{t.type}</strong> {t.tool ? `(${t.tool})` : ""} — {t.content}
                </li>
              ))}
            </ul>
          </div>
        </section>
      </main>

      {showConfirm && (
        <div className="modal">
          <div className="modal-body">
            <p>{showConfirm.message}</p>
            <div className="modal-actions">
              {showConfirm.options.map(opt => (
                <button key={opt} onClick={()=>{
                  fetch("/agent-action", { method: "POST", headers:{ "Content-Type":"application/json" }, body: JSON.stringify({ run_id: runId, action: opt, payload: showConfirm.payload })});
                  setShowConfirm(null);
                }}>{opt}</button>
              ))}
              <button onClick={()=>setShowConfirm(null)}>Dismiss</button>
            </div>
          </div>
        </div>
      )}

      <footer>
        <small>FlightOps Assistant — frontend demo</small>
      </footer>
    </div>
  );
}
###################################################################
export function parseSSEChunks(buffer) {
  const parts = buffer.split("\n\n");
  const remainder = parts.pop();
  const events = [];
  for (const part of parts) {
    if (!part.trim()) continue;
    const lines = part.split("\n").map(l => l.trim()).filter(Boolean);
    let event = "message";
    let data = null;
    for (const line of lines) {
      if (line.startsWith("event:")) event = line.replace("event:", "").trim();
      else if (line.startsWith("data:")) {
        const d = line.replace("data:", "").trim();
        try {
          data = JSON.parse(d);
        } catch (e) {
          data = d;
        }
      }
    }
    events.push({ event, data });
  }
  return [events, remainder];
}
