client_singleton = None

def sse_event(event_name: str, payload: dict) -> str:
    payload_json = json.dumps(payload, default=str, ensure_ascii=False)
    return f"event: {event_name}\ndata: {payload_json}\n\n"

@app.post("/get_data")
async def get_data(userprompt: str = Body(..., embed=True)):
    """
    Accepts JSON body: { "userprompt": "..." }
    Streams SSE events back to client.
    """
    global client_singleton
    if client_singleton is None:
        client_singleton = FlightOpsMCPClient()

    async def event_gen():
        # queue to receive events from client callback
        q = asyncio.Queue()

        # on_event callback that puts items into queue
        def on_event(name, payload):
            # ensure JSON-serializable payload
            try:
                asyncio.get_event_loop().call_soon_threadsafe(q.put_nowait, (name, payload))
            except Exception:
                # fallback synchronous
                q.put_nowait((name, payload))

        # Run the query in background task
        task = asyncio.create_task(client_singleton.run_query(userprompt, on_event=on_event))

        try:
            while True:
                try:
                    name, payload = await asyncio.wait_for(q.get(), timeout=0.5)
                    yield sse_event(name, payload)
                except asyncio.TimeoutError:
                    # if background finished and queue empty -> stop
                    if task.done():
                        # drain remaining
                        while not q.empty():
                            name, payload = q.get_nowait()
                            yield sse_event(name, payload)
                        break
        except asyncio.CancelledError:
            # If client disconnects, cancel background task
            if not task.done():
                task.cancel()
                with contextlib.suppress(asyncio.CancelledError):
                    await task
            raise
        except Exception as e:
            yield sse_event("RUN_ERROR", {"error": str(e)})
        finally:
            # ensure task complete
            if not task.done():
                task.cancel()
                with contextlib.suppress(asyncio.CancelledError):
                    await task

    return StreamingResponse(event_gen(), media_type="text/event-stream",
                             headers={"Cache-Control": "no-cache", "Connection": "keep-alive"})

