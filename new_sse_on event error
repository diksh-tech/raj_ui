import os
import json
import asyncio
import logging
from typing import AsyncGenerator, Callable

from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse, PlainTextResponse
from pydantic import BaseModel

# >>> IMPORTANT: we reuse your FlightOpsMCPClient from server.py
# server.py must be in PYTHONPATH or same folder as this file.
from server import FlightOpsMCPClient

logging.basicConfig(level=os.getenv("LOG_LEVEL", "INFO"))
log = logging.getLogger("agui.fastapi")

app = FastAPI(title="AG-UI FastAPI Gateway")

# --- CORS (Vite dev on 5173) ---
app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5173",
        "http://127.0.0.1:5173",
    ],
    allow_credentials=True,
