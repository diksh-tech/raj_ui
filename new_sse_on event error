import React, { useState, useRef } from "react";
import { postSSE } from "./api.js";
import { chunkText } from "./sseHelpers.js";

const BACKEND = "http://127.0.0.1:8001";

export default function App() {
  const [prompt, setPrompt] = useState("6E 215 status today");
  const [busy, setBusy] = useState(false);
  const [thinking, setThinking] = useState(false);
  const [processing, setProcessing] = useState(false);
  const [done, setDone] = useState(false);

  const [transcript, setTranscript] = useState("");
  const [logs, setLogs] = useState([]);
  const abortRef = useRef(null);

  const pushLog = (obj) => {
    setLogs((prev) => [
      ...prev,
      { t: new Date().toLocaleTimeString(), ...obj },
    ]);
  };

  const handleStop = () => {
    if (abortRef.current) {
      abortRef.current.abort();
      pushLog({ type: "info", msg: "aborted by user" });
      setBusy(false);
      setThinking(false);
      setProcessing(false);
    }
  };

  const handleSend = async () => {
    setBusy(true);
    setThinking(false);
    setProcessing(false);
    setDone(false);
    setTranscript("");
    setLogs([]);

    const controller = new AbortController();
    abortRef.current = controller;

    try {
      for await (const evt of postSSE(`${BACKEND}/get_data`, { userprompt: prompt })) {
        switch (evt.event) {
          case "RUN_STARTED":
            pushLog({ type: "run", msg: `run started (${evt.data?.run_id || ""})` });
            setThinking(true);
            break;

          case "THINKING":
            setThinking(true);
            pushLog({ type: "thinking", msg: evt.data?.stage || "thinking" });
            break;

          case "STATE_DELTA":
            if (evt.data?.stage === "plan_ready") {
              pushLog({ type: "plan", msg: "plan ready", plan: evt.data.plan });
              setProcessing(true);
            } else if (evt.data?.stage === "tool_started") {
              pushLog({ type: "tool", msg: `tool started: ${evt.data.tool}`, args: evt.data.args });
            } else if (evt.data?.stage === "tool_finished") {
              pushLog({ type: "tool", msg: `tool finished: ${evt.data.tool}` });
            } else if (evt.data?.stage === "summarize_started") {
              pushLog({ type: "info", msg: "summarize started" });
            } else if (evt.data?.stage === "summarize_finished") {
              pushLog({ type: "info", msg: "summarize finished" });
            }
            break;

          case "TOOL_CALL_STARTED":
            pushLog({ type: "tool_call", msg: `→ ${evt.data.tool}`, args: evt.data.args });
            break;

          case "TOOL_CALL_FINISHED":
            pushLog({ type: "tool_result", msg: `← ${evt.data.tool}`, result: evt.data.result });
            break;

          case "TEXT_MESSAGE_CONTENT":
            setThinking(false);
            setProcessing(true);
            setTranscript((prev) => prev + (evt.data?.text || ""));
            break;

          case "RUN_FINISHED":
            setBusy(false);
            setThinking(false);
            setProcessing(false);
            setDone(true);
            pushLog({ type: "run", msg: `run finished (${evt.data?.status || "ok"})` });
            break;

          default:
            pushLog({ type: "event", msg: evt.event, data: evt.data });
        }
      }
    } catch (err) {
      pushLog({ type: "error", msg: String(err) });
    } finally {
      setBusy(false);
      abortRef.current = null;
    }
  };

  return (
    <div className="app">
      <header>
        <h1>FlightOps Assistant (IndiGo)</h1>
        <div className="small">Vite + React (JS) • Streaming SSE</div>
      </header>

      <div className="controls">
        <textarea
          placeholder="Type your flight ops query…"
          value={prompt}
          onChange={(e) => setPrompt(e.target.value)}
        />
        <div className="buttons">
          <button onClick={handleSend} disabled={busy || !prompt.trim()}>Send</button>
          <button onClick={handleStop} disabled={!busy}>Stop</button>
          <button onClick={() => { setTranscript(""); setLogs([]); setDone(false); }}>Clear</button>
        </div>

        <div className="badges">
          {thinking && <span className="badge thinking">🧠 Thinking…</span>}
          {processing && <span className="badge processing">⚙️ Processing…</span>}
          {done && <span className="badge done">✅ Done</span>}
        </div>
      </div>

      <div className="stream">
        <div className="transcript">
          {transcript || <span className="small">Assistant response will stream here…</span>}
        </div>
        <div className="tool-logs">
          {logs.length === 0 && <div className="small">Tool logs will appear here…</div>}
          {logs.map((l, i) => (
            <div className="log" key={i}>
              <span className="kv">{l.t}</span> — <strong>{l.type}</strong>: {l.msg}
              {l.plan && <pre>{JSON.stringify(l.plan, null, 2)}</pre>}
              {l.args && <pre>{JSON.stringify(l.args, null, 2)}</pre>}
              {l.result && <pre>{JSON.stringify(l.result, null, 2)}</pre>}
              {l.data && <pre>{JSON.stringify(l.data, null, 2)}</pre>}
            </div>
          ))}
        </div>
      </div>

      <div className="footer">
        Built by Deeksha • Project: FlightOps Assistant
      </div>
    </div>
  );
}
