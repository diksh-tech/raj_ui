    allow_headers=["*"],
)

class QueryBody(BaseModel):
    userprompt: str

@app.get("/health", response_class=PlainTextResponse)
async def health():
    return "OK"

def sse_format(event: str, data: dict | str) -> bytes:
    """Format a single SSE event block."""
    if isinstance(data, (dict, list)):
        payload = json.dumps(data, ensure_ascii=False)
    else:
        payload = str(data)
    block = f"event: {event}\n" + "\n".join(
        [f"data: {line}" for line in payload.splitlines() or [""]]
    ) + "\n\n"
    return block.encode("utf-8")

def chunk_text(txt: str, size: int = 400) -> list[str]:
    txt = txt or ""
    return [txt[i:i+size] for i in range(0, len(txt), size)] or [""]

async def stream_text(event_send: Callable[[str, dict | str], asyncio.Future], text: str):
    """Stream a long text as incremental TEXT_MESSAGE_CONTENT chunks."""
    for chunk in chunk_text(text, 400):
        await event_send("TEXT_MESSAGE_CONTENT", {"text": chunk})
        # tiny delay for UI feel
        await asyncio.sleep(0.01)

@app.post("/get_data")
async def get_data(req: Request, body: QueryBody):
    """
    Streams back AG-UI style events over SSE:
      - RUN_STARTED
      - THINKING (planning)
      - STATE_DELTA (plan_ready / tool_started / tool_finished / summarize_started / summarize_finished)
      - TOOL_CALL_STARTED / TOOL_CALL_FINISHED
      - TEXT_MESSAGE_CONTENT (assistant streaming text)
      - RUN_FINISHED
    """
    userprompt = body.userprompt.strip()
    client = FlightOpsMCPClient()

    async def event_gen() -> AsyncGenerator[bytes, None]:
        # Helper to send events
        async def send(event: str, data: dict | str):
            yield sse_format(event, data)

        # Wrapper so we can call it with 'await event_send(...)' above
        async def event_send(event: str, data: dict | str):
            nonlocal queue
            await queue.put(sse_format(event, data))

        # A small queue so we can yield from a single generator
        queue: asyncio.Queue[bytes] = asyncio.Queue()

        async def producer():
            # 1) RUN_STARTED
            await queue.put(sse_format("RUN_STARTED", {"run_id": "run-" + os.urandom(4).hex()}))

            # 2) THINKING (planning)
            await queue.put(sse_format("THINKING", {"stage": "planning"}))

            # 3) PLAN
            try:
                plan_data = client.plan_tools(userprompt)
            except Exception as e:
                await queue.put(sse_format("STATE_DELTA", {"stage": "plan_failed", "error": str(e)}))
                await queue.put(sse_format("RUN_FINISHED", {"status": "error"}))
                await queue.put(b"")
                return

            plan = plan_data.get("plan", [])
            await queue.put(sse_format("STATE_DELTA", {"stage": "plan_ready", "plan": plan}))

            results = []

            # 4) Execute tools one-by-one
            for i, step in enumerate(plan):
                tool = step.get("tool")
                args = step.get("arguments", {}) or {}
                # sanitize args (removes blanks/"unknown")
                args = {k: v for k, v in args.items() if v and str(v).strip().lower() != "unknown"}

                await queue.put(sse_format("STATE_DELTA", {"stage": "tool_started", "tool": tool, "args": args}))
                await queue.put(sse_format("TOOL_CALL_STARTED", {"tool": tool, "args": args}))

                try:
                    resp = await client.invoke_tool(tool, args)
                except Exception as e:
                    resp = {"error": str(e)}

                await queue.put(sse_format("TOOL_CALL_FINISHED", {"tool": tool, "result": resp}))
                await queue.put(sse_format("STATE_DELTA", {"stage": "tool_finished", "tool": tool}))
                results.append({tool: resp})

            # 5) THINKING (summarize)
            await queue.put(sse_format("THINKING", {"stage": "summarizing"}))
            await queue.put(sse_format("STATE_DELTA", {"stage": "summarize_started"}))

            try:
                summary_obj = client.summarize_results(userprompt, plan, results)
                summary_text = (summary_obj or {}).get("summary", "") or ""
            except Exception as e:
                summary_text = f"Summary failed: {e}"

            # 6) Stream assistant text
            await stream_text(event_send, summary_text)

            await queue.put(sse_format("STATE_DELTA", {"stage": "summarize_finished"}))
            await queue.put(sse_format("RUN_FINISHED", {"status": "ok"}))
            await queue.put(b"")

        # Fire producer and drain queue
        task = asyncio.create_task(producer())
        try:
            while True:
                chunk = await queue.get()
                if chunk == b"":
                    break
                yield chunk
        finally:
            task.cancel()

    headers = {
        "Cache-Control": "no-cache",
        "Connection": "keep-alive",
        "Content-Type": "text/event-stream; charset=utf-8",
    }
    return StreamingResponse(event_gen(), headers=headers)
