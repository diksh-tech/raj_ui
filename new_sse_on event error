// Small utilities to parse Server-Sent Events and chunk text

export function parseSSEChunks(rawText) {
  // Splits SSE stream into discrete event blocks separated by blank lines
  const blocks = rawText.split(/\r?\n\r?\n/);
  const events = [];

  for (const block of blocks) {
    if (!block.trim()) continue;
    let ev = { event: "message", data: "" };

    const lines = block.split(/\r?\n/);
    for (const line of lines) {
      if (line.startsWith("event:")) {
        ev.event = line.slice(6).trim();
      } else if (line.startsWith("data:")) {
        ev.data += (ev.data ? "\n" : "") + line.slice(5).trim();
      }
    }
    if (ev.data) {
      try {
        ev.data = JSON.parse(ev.data);
      } catch {
        // keep as string
      }
      events.push(ev);
    }
  }
  return events;
}

export function chunkText(text, size = 400) {
  if (!text) return [""];
  const out = [];
  for (let i = 0; i < text.length; i += size) {
    out.push(text.slice(i, i + size));
  }
  return out;
}
