          <div key={i} style={{ whiteSpace: "pre-wrap", marginBottom: 8 }}>
            <b>{m.role}:</b> {m.content}
          </div>
        ))}
      </div>
      <div style={{ border: "1px solid #ddd", padding: 12, marginBottom: 12 }}>
        <b>Tool Calls</b>
        {Object.entries(tools).map(([id, r]) => (
          <div key={id} style={{ fontSize: 14, marginTop: 8 }}>
            #{id.slice(0,8)} {r.name} — {r.status || "…"}
            {r.args ? <div>args: <code>{JSON.stringify(r.args)}</code></div> : null}
            {r.result ? <div>result: <code>{JSON.stringify(r.result)}</code></div> : null}
          </div>
        ))}
      </div>

      <div style={{ display: "flex", gap: 8 }}>
        <input style={{ flex: 1 }} value={input} onChange={(e) => setInput(e.target.value)} placeholder="Ask about flights, delays, fuel…" />
        <button onClick={send}>Send</button>
      </div>
    </div>
  );
