  import { useState } from "react";
import { aguiStream } from "./aguiClient";

export default function App() {
  const [messages, setMessages] = useState([]);
  const [tools, setTools] = useState({});
  const [input, setInput] = useState("");

  const send = async () => {
    const userMsg = { role: "user", content: input };
    setMessages((m) => [...m, userMsg]);

    const payload = { messages: [...messages, userMsg], state: {} };
    for await (const ev of aguiStream("http://localhost:8001/agui/chat", payload)) {
      switch (ev.type) {
        case "TEXT_MESSAGE_START":
          setMessages((m) => [...m, { role: "assistant", content: "", messageId: ev.messageId }]);
          break;
        case "TEXT_MESSAGE_CONTENT":
          setMessages((m) => {
            const copy = [...m];
            const idx = copy.findIndex(x => x.messageId === ev.messageId);
            if (idx === -1) copy.push({ role: "assistant", content: ev.text || "", messageId: ev.messageId });
            else copy[idx] = { ...copy[idx], content: (copy[idx].content || "") + (ev.text || "") };
            return copy;
          });
          break;
        case "TEXT_MESSAGE_END":
          break;
        case "TOOL_CALL_START":
          setTools((t) => ({ ...t, [ev.toolCallId]: { name: ev.name, status: "running" } }));
          break;
        case "TOOL_CALL_ARGS":
          setTools((t) => ({ ...t, [ev.toolCallId]: { ...t[ev.toolCallId], args: ev.args } }));
          break;
        case "TOOL_CALL_RESULT":
          setTools((t) => ({ ...t, [ev.toolCallId]: { ...t[ev.toolCallId], result: ev.result } }));
          break;
        case "TOOL_CALL_END":
          setTools((t) => ({ ...t, [ev.toolCallId]: { ...t[ev.toolCallId], status: ev.ok ? "ok" : "error" } }));
          break;
        case "STATE_DELTA":
          // optional: maintain a local shared state tree and apply JSON Patch
          break;
        default:
          break;
      }
    }
    setInput("");
  };

  return (
    <div style={{ maxWidth: 720, margin: "24px auto", fontFamily: "system-ui, sans-serif" }}>
      <h2>FlightOps — AG-UI</h2>
      <div style={{ border: "1px solid #ddd", padding: 12, marginBottom: 12, minHeight: 180 }}>
