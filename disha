import json, logging, asyncio
from typing import AsyncGenerator
from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse

from agui import ndjson, text_start, text_content, text_end, tool_start, tool_args, tool_result, tool_end, state_delta, new_ids
from client_runner import FlightOpsMCPClient

logger = logging.getLogger("FlightOps.AGUI")
app = FastAPI()

# CORS (Vite dev server)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173","http://127.0.0.1:5173","*"],
    allow_credentials=True, allow_methods=["*"], allow_headers=["*"],
)

mcp_client = FlightOpsMCPClient()

@app.post("/agui/chat")
async def agui_chat(req: Request):
    """
    Accepts: { messages:[{role, content}...], state:{} }
    Emits NDJSON AG-UI events.
    """
    body = await req.json()
    messages = body.get("messages", [])
    user_msg = messages[-1]["content"] if messages else ""
    app_state = body.get("state", {})  # optional shared state

    async def stream() -> AsyncGenerator[bytes, None]:
        # 1) Start assistant message
        msg_id, _ = new_ids()
        yield ndjson(text_start(msg_id))

        # 2) PLAN via LLM (non-stream)
        plan_data = mcp_client.plan_tools(user_msg)
        plan = plan_data.get("plan", [])

        # Optional: show plan in UI as state delta
        if plan:
            yield ndjson(state_delta([{"op":"add","path":"/lastPlan","value":plan}]))

        # 3) Execute tools sequentially and stream TOOL_CALL_* events
        results = []
        for step in plan:
            tool = step.get("tool")
            args = step.get("arguments", {}) or {}
            # clean trivial empties
            args = {k: v for k, v in args.items() if v not in (None, "", "unknown")}

            t_id = msg_id  # reuse message scope or make per-tool id if you want
            yield ndjson(tool_start(t_id, tool))
            yield ndjson(tool_args(t_id, args))
            try:
                resp = await mcp_client.invoke_tool(tool, args)
                results.append({tool: resp})
                yield ndjson(tool_result(t_id, resp))
                yield ndjson(tool_end(t_id, True))
            except Exception as e:
                err = {"error": str(e)}
                results.append({tool: err})
                yield ndjson(tool_result(t_id, err))
                yield ndjson(tool_end(t_id, False))

        # 4) Summarize (non-stream: one shot text added as CONTENT)
        summary = mcp_client.summarize_results(user_msg, plan, results) if plan else "No tool plan generated."
        if summary:
            # चाहो तो यहाँ chunking करो; अभी एक ही CONTENT event भेजते हैं
            yield ndjson(text_content(msg_id, summary))

        # 5) End assistant message
        yield ndjson(text_end(msg_id))

    return StreamingResponse(stream(), media_type="application/x-ndjson")
