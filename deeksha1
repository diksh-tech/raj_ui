import React from "react";

export default function EventStreamViewer({ events }) {
  if (!events.length) return <p>No events yet.</p>;
  const box = { background: "#f7f7f9", padding: 10, borderRadius: 8, marginBottom: 8 };

  return (
    <div>
      {events.map((e, i) => (
        <div style={box} key={i}>
          <pre style={{ margin: 0, whiteSpace: "pre-wrap" }}>{JSON.stringify(e, null, 2)}</pre>
        </div>
      ))}
    </div>
  );
}
