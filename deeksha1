import os, json, uuid, asyncio, logging
from typing import AsyncGenerator
from fastapi import FastAPI, Request, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse
from dotenv import load_dotenv
from client import FlightOpsMCPClient

load_dotenv()
logging.basicConfig(level=os.getenv("LOG_LEVEL", "INFO"))
logger = logging.getLogger("AGUI.Adapter")

app = FastAPI(title="FlightOps — AG-UI Adapter")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173", "http://127.0.0.1:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

mcp_client = FlightOpsMCPClient()

def sse_event(data: dict) -> str:
    return f"data: {json.dumps(data, ensure_ascii=False)}\n\n"

async def ensure_mcp_connected():
    if not mcp_client.session:
        await mcp_client.connect()

@app.on_event("startup")
async def startup_event():
    try:
        await ensure_mcp_connected()
    except Exception as e:
        logger.warning(f"MCP preconnect failed: {e}")

@app.post("/agent")
async def run_agent(request: Request):
    try:
        body = await request.json()
    except Exception:
        raise HTTPException(status_code=400, detail="Invalid JSON body")

    messages = body.get("messages", [])
    if not messages:
        raise HTTPException(status_code=400, detail="Missing messages")

    last = messages[-1]
    user_query = last.get("content") if isinstance(last, dict) else str(last)
    if not user_query:
        raise HTTPException(status_code=400, detail="Empty user query")

    thread_id = body.get("thread_id") or f"thread-{uuid.uuid4().hex[:8]}"
    run_id = body.get("run_id") or f"run-{uuid.uuid4().hex[:8]}"

    async def event_stream() -> AsyncGenerator[str, None]:
        yield sse_event({"type": "RUN_STARTED", "thread_id": thread_id, "run_id": run_id})

        try:
            await ensure_mcp_connected()
        except Exception as e:
            yield sse_event({"type": "RUN_ERROR", "error": f"MCP connection failed: {e}"})
            return

        loop = asyncio.get_event_loop()

        # Plan (in thread executor to avoid blocking event loop)
        yield sse_event({"type": "TEXT_MESSAGE_CONTENT", "content": "Planning tool calls..."})
        plan_obj = await loop.run_in_executor(None, mcp_client.plan_tools, user_query)
        plan = plan_obj.get("plan", [])
        yield sse_event({"type": "STATE_SNAPSHOT", "plan": plan})

        if not plan:
            yield sse_event({"type": "RUN_FINISHED", "reason": "NO_PLAN"})
            return

        # Execute tools
        results = []
        for idx, step in enumerate(plan):
            tool_name = step.get("tool")
            args = step.get("arguments", {}) or {}
            # clean args
            args = {k: v for k, v in args.items() if v and str(v).strip().lower() != "unknown"}
            tool_call_id = f"toolcall-{uuid.uuid4().hex[:8]}"

            yield sse_event({"type": "TOOL_CALL_START", "toolCallId": tool_call_id, "toolCallName": tool_name})
            yield sse_event({"type": "TOOL_CALL_ARGS", "toolCallId": tool_call_id, "args": args})

            try:
                tool_result = await mcp_client.invoke_tool(tool_name, args)
            except Exception as e:
                tool_result = {"error": str(e)}

            results.append({tool_name: tool_result})
            yield sse_event({"type": "TOOL_CALL_RESULT", "toolCallId": tool_call_id, "result": tool_result})
            yield sse_event({"type": "TOOL_CALL_END", "toolCallId": tool_call_id})

        # Summarize (thread pool)
        yield sse_event({"type": "TEXT_MESSAGE_CONTENT", "content": "Summarizing results..."})
        summary = await loop.run_in_executor(None, mcp_client.summarize_results, user_query, plan, results)

        yield sse_event({
            "type": "TEXT_MESSAGE_CONTENT",
            "role": "assistant",
            "content": summary.get("summary", "")
        })
        yield sse_event({"type": "STATE_SNAPSHOT", "snapshot": {"plan": plan, "results": results, "summary": summary}})
        yield sse_event({"type": "RUN_FINISHED", "run_id": run_id})

    return StreamingResponse(event_stream(), media_type="text/event-stream")
