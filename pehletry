      {ids.map((id) => {
        const r = runs[id];
        const statusColor = r.status === "ok" ? "#4caf50" : r.status === "error" ? "#f44336" : "#ff9800";
        
        return (
          <div key={id} style={{ fontSize: 14, marginTop: 8, padding: 8, border: "1px solid #e0e0e0", borderRadius: 4 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
