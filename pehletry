import os, json, logging, asyncio
from dotenv import load_dotenv
from openai import AzureOpenAI
from mcp import ClientSession
from mcp.client.streamable_http import streamablehttp_client
from tool_registry import TOOLS

load_dotenv()
logger = logging.getLogger("FlightOps.MCPClient")
logging.basicConfig(level=os.getenv("LOG_LEVEL", "INFO"))

MCP_SERVER_URL = os.getenv("MCP_SERVER_URL", "http://127.0.0.1:8000")

AZURE_OPENAI_KEY = os.getenv("AZURE_OPENAI_KEY")
AZURE_OPENAI_ENDPOINT = os.getenv("AZURE_OPENAI_ENDPOINT")
AZURE_OPENAI_DEPLOYMENT = os.getenv("AZURE_OPENAI_DEPLOYMENT", "gpt-4o")
AZURE_API_VERSION = os.getenv("AZURE_API_VERSION", "2024-12-01-preview")

if not AZURE_OPENAI_KEY:
    logger.warning("❌ AZURE_OPENAI_KEY not set - summarization will not work")

client_azure = None
if AZURE_OPENAI_KEY:
    try:
        client_azure = AzureOpenAI(
            api_key=AZURE_OPENAI_KEY,
            api_version=AZURE_API_VERSION,
            azure_endpoint=AZURE_OPENAI_ENDPOINT
        )
    except Exception as e:
        logger.error(f"❌ Azure OpenAI client initialization failed: {e}")

def _build_tool_prompt() -> str:
    return "\n".join([f"- {name}({', '.join(meta['args'])}): {meta['desc']}" for name, meta in TOOLS.items()])

SYSTEM_PROMPT_PLAN = f"""
You are an assistant that converts user questions into MCP tool calls.

Available tools:
{_build_tool_prompt()}

Rules:
- For single flight queries: Use specific tools like get_flight_basic_info, get_operation_times, etc.
- For analytics/queries across multiple flights: Use raw_mongodb_query or run_aggregated_query
- Always provide carrier (e.g., "6E" for IndiGo), flight_number, and date_of_origin when available
- For date_of_origin, use YYYY-MM-DD format
- Return valid JSON with "plan" array containing tool calls

Example response:
{{
  "plan": [
    {{
      "tool": "get_flight_basic_info",
      "arguments": {{
        "carrier": "6E",
        "flight_number": "101",
        "date_of_origin": "2024-12-01"
      }}
    }}
  ]
}}
"""

SYSTEM_PROMPT_SUMMARIZE = """
You are a helpful flight operations assistant. Summarize the tool outputs for the user in a clear, concise manner.

Guidelines:
- Be factual and use the data provided
- Highlight key information like delays, status changes, or important metrics
- Use bullet points for lists when helpful
- Keep it professional but friendly
- If there are errors in the data, mention them clearly
"""

class FlightOpsMCPClient:
    def __init__(self):
        self.session: ClientSession | None = None
        self._client_context = None
        self.connected = False

    async def connect(self, retries=3, delay=2):
        """Connect to the MCP server with retry logic"""
        if self.connected:
            return
            
        for attempt in range(retries):
            try:
                logger.info(f"Connecting to MCP server at {MCP_SERVER_URL} (attempt {attempt+1}/{retries})")
                
                # Use streamable-http client
                self._client_context = streamablehttp_client(MCP_SERVER_URL)
                read_stream, write_stream, _ = await self._client_context.__aenter__()
                
                self.session = ClientSession(read_stream, write_stream)
                await self.session.__aenter__()
                await self.session.initialize()
                
                self.connected = True
                logger.info("✅ Successfully connected to MCP server")
                return
                
            except Exception as e:
                logger.error(f"❌ Connection attempt {attempt+1} failed: {e}")
                if attempt < retries - 1:
                    logger.info(f"Retrying in {delay} seconds...")
                    await asyncio.sleep(delay)
                else:
                    raise ConnectionError(f"Failed to connect to MCP server after {retries} attempts: {e}")

    async def disconnect(self):
        """Disconnect from the MCP server"""
        try:
            if self.session:
                await self.session.__aexit__(None, None, None)
            if self._client_context:
                await self._client_context.__aexit__(None, None, None)
            self.connected = False
            logger.info("Disconnected from MCP server")
        except Exception as e:
            logger.error(f"Error disconnecting: {e}")

    def _call_azure_openai(self, messages: list, temperature=0.2, max_tokens=1024) -> str:
        """Call Azure OpenAI for planning or summarization"""
        if not client_azure:
            return "Azure OpenAI not configured - using fallback planning"
            
        try:
            response = client_azure.chat.completions.create(
                model=AZURE_OPENAI_DEPLOYMENT,
                messages=messages,
                temperature=temperature,
                max_tokens=max_tokens,
            )
            return response.choices[0].message.content or ""
        except Exception as e:
            logger.error(f"Azure OpenAI error: {e}")
            return f"Error calling Azure OpenAI: {str(e)}"

    async def list_tools(self) -> dict:
        """List available tools from MCP server"""
        if not self.connected:
            await self.connect()
            
        try:
            tools_list = await self.session.list_tools()
            return {
                "tools": {
                    t.name: {
                        "description": t.description,
                        "inputSchema": t.inputSchema
                    } for t in tools_list.tools
                }
            }
        except Exception as e:
            logger.error(f"Error listing tools: {e}")
            return {"tools": {}, "error": str(e)}

    async def invoke_tool(self, tool_name: str, args: dict) -> dict:
        """Invoke a tool on the MCP server"""
        if not self.connected:
            await self.connect()
            
        logger.info(f"Calling tool {tool_name} with args: {args}")
        
        try:
            result = await self.session.call_tool(tool_name, args)
            
            if result.isError:
                error_msg = result.content[0].text if result.content else "Unknown error"
                logger.error(f"Tool {tool_name} returned error: {error_msg}")
                return {"error": error_msg}
                
            # Process successful result
            if result.content:
                items = []
                for item in result.content:
                    if hasattr(item, "text"):
                        try:
                            # Try to parse JSON response
                            parsed = json.loads(item.text)
                            items.append(parsed)
                        except json.JSONDecodeError:
                            # Keep as text if not JSON
                            items.append(item.text)
                
                if len(items) == 1:
                    return items[0]
                else:
                    return {"results": items}
                    
            return {"status": "success", "message": "Tool executed successfully"}
            
        except Exception as e:
            logger.error(f"Tool invocation failed for {tool_name}: {e}")
            return {"error": f"Tool call failed: {str(e)}"}

    def plan_tools(self, user_query: str) -> dict:
        """Use Azure OpenAI to plan which tools to call for the user query"""
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT_PLAN},
            {"role": "user", "content": user_query},
        ]
        
        content = self._call_azure_openai(messages, temperature=0.1)
        
        if not content or content.startswith("Error"):
            logger.warning("Azure OpenAI not available for planning, using fallback")
            return self._fallback_plan(user_query)
            
        # Clean and parse the response
        cleaned = content.strip()
        if cleaned.startswith("```json"):
            cleaned = cleaned[7:-3].strip()
        elif cleaned.startswith("```"):
            cleaned = cleaned[3:-3].strip()
            
        try:
            plan = json.loads(cleaned)
            if isinstance(plan, dict) and "plan" in plan:
                return plan
            else:
                return {"plan": []}
        except json.JSONDecodeError:
            logger.warning(f"Failed to parse plan JSON: {cleaned}")
            return self._fallback_plan(user_query)

    def _fallback_plan(self, user_query: str) -> dict:
        """Fallback planning when Azure OpenAI is not available"""
        query_lower = user_query.lower()
        
        # Simple keyword-based planning
        if any(word in query_lower for word in ["health", "status", "alive"]):
            return {"plan": [{"tool": "health_check", "arguments": {}}]}
            
        elif any(word in query_lower for word in ["basic", "info", "details", "flight"]):
            return {"plan": [{"tool": "get_flight_basic_info", "arguments": self._extract_flight_args(user_query)}]}
            
        elif any(word in query_lower for word in ["time", "schedule", "operation"]):
            return {"plan": [{"tool": "get_operation_times", "arguments": self._extract_flight_args(user_query)}]}
            
        elif any(word in query_lower for word in ["equipment", "aircraft", "plane"]):
            return {"plan": [{"tool": "get_equipment_info", "arguments": self._extract_flight_args(user_query)}]}
            
        elif any(word in query_lower for word in ["delay", "late"]):
            return {"plan": [{"tool": "get_delay_summary", "arguments": self._extract_flight_args(user_query)}]}
            
        else:
            # Default to basic info
            return {"plan": [{"tool": "get_flight_basic_info", "arguments": self._extract_flight_args(user_query)}]}

    def _extract_flight_args(self, user_query: str) -> dict:
        """Extract flight arguments from user query (simplified)"""
        args = {}
        query_lower = user_query.lower()
        
        # Extract carrier (simplified)
        if "6e" in query_lower or "indigo" in query_lower:
            args["carrier"] = "6E"
        elif "ai" in query_lower or "air india" in query_lower:
            args["carrier"] = "AI"
            
        # Extract flight number (very simplified)
        import re
        flight_match = re.search(r'flight\s+(\d+)', query_lower)
        if flight_match:
            args["flight_number"] = flight_match.group(1)
        else:
            # Try to find any 3-digit number as flight number
            numbers = re.findall(r'\b(\d{3})\b', user_query)
            if numbers:
                args["flight_number"] = numbers[0]
            
        # Try to extract date (simplified)
        date_match = re.search(r'(\d{4}-\d{2}-\d{2})', user_query)
        if date_match:
            args["date_of_origin"] = date_match.group(1)
            
        return args

    def summarize_results(self, user_query: str, plan: list, results: list) -> str:
        """Summarize the tool results using Azure OpenAI"""
        if not plan:
            return "I couldn't determine which tools to use for your query. Please try rephrasing with specific flight details."
            
        if not client_azure:
            # Fallback summarization
            return self._fallback_summary(user_query, plan, results)
            
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT_SUMMARIZE},
            {"role": "user", "content": f"User question: {user_query}"},
            {"role": "assistant", "content": f"Tool execution plan: {json.dumps(plan, indent=2)}"},
            {"role": "assistant", "content": f"Tool results: {json.dumps(results, indent=2)}"},
        ]
        
        summary = self._call_azure_openai(messages, temperature=0.3)
        
        if not summary or summary.startswith("Error"):
            return self._fallback_summary(user_query, plan, results)
            
        return summary

    def _fallback_summary(self, user_query: str, plan: list, results: list) -> str:
        """Fallback summarization when Azure OpenAI is not available"""
        summary_parts = [f"Regarding your question: '{user_query}'"]
        
        for i, (step, result) in enumerate(zip(plan, results)):
            tool_name = step.get("tool", "unknown")
            tool_args = step.get("arguments", {})
            
            summary_parts.append(f"\n**{tool_name}** with arguments: {tool_args}")
            
            for key, value in result.items():
                if key == tool_name:
                    if isinstance(value, dict):
                        if "ok" in value:
                            if value["ok"]:
                                data = value.get("data", {})
                                if data:
                                    summary_parts.append(f"✅ Found data: {json.dumps(data, indent=2)[:500]}...")
                                else:
                                    summary_parts.append("✅ Operation completed successfully")
                            else:
                                summary_parts.append(f"❌ Error: {value.get('error', 'Unknown error')}")
                        else:
                            summary_parts.append(f"Result: {json.dumps(value, indent=2)[:300]}...")
                    else:
                        summary_parts.append(f"Result: {str(value)[:300]}...")
                        
        return "\n".join(summary_parts)
