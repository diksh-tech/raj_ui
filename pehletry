- Numerical summaries → run_aggregated_query (query_type + field [+ filter_json/start_date/end_date]).
- Listings/filters → raw_mongodb_query (query_json + projection + limit).
- Single-flight facts → specific tools (get_flight_basic_info, get_operation_times, ...).
- Always return valid JSON with top-level "plan".
- Never include "_id" in projections.
"""

SYSTEM_PROMPT_SUMMARIZE = """
Summarize tool outputs for the user. Be concise, factual. Use bullets if helpful.
"""

class FlightOpsMCPClient:
    def __init__(self, base_url: str = None):
        self.base_url = (base_url or MCP_SERVER_URL).rstrip("/")
        self.session: ClientSession | None = None
        self._client_context = None

    async def connect(self):
        logger.info(f"Connecting to MCP server at {self.base_url}")
        try:
            self._client_context = streamablehttp_client(self.base_url)
            read_stream, write_stream, _ = await self._client_context.__aenter__()
            self.session = ClientSession(read_stream, write_stream)
            await self.session.__aenter__()
            await self.session.initialize()
            logger.info("✅ Connected to MCP server")
        except Exception as e:
            logger.error(f"❌ Failed to connect to MCP server: {e}")
            raise

    async def disconnect(self):
        try:
            if self.session:
                await self.session.__aexit__(None, None, None)
            if self._client_context:
                await self._client_context.__aexit__(None, None, None)
        except Exception as e:
            logger.error(f"Disconnect error: {e}")

    def _call_azure_openai(self, messages: list, temperature=0.2, max_tokens=1024) -> str:
        try:
            c = client_azure.chat.completions.create(
                model=AZURE_OPENAI_DEPLOYMENT,
                messages=messages,
                temperature=temperature,
                max_tokens=max_tokens,
            )
            return c.choices[0].message.content or ""
        except Exception as e:
            logger.error(f"Azure OpenAI error: {e}")
            return f"Error calling Azure OpenAI: {str(e)}"

    async def list_tools(self) -> dict:
        if not self.session:
            await self.connect()
        tools_list = await self.session.list_tools()
        return { "tools": { t.name: {"description": t.description, "inputSchema": t.inputSchema} for t in tools_list.tools } }

    async def invoke_tool(self, tool_name: str, args: dict) -> dict:
        if not self.session:
            await self.connect()
        logger.info(f"Calling tool {tool_name} args={args}")
        try:
            result = await self.session.call_tool(tool_name, args)
            if result.content:
                items = []
                for it in result.content:
                    if hasattr(it, "text"):
                        try:
                            items.append(json.loads(it.text))
                        except json.JSONDecodeError:
                            items.append(it.text)
                return items[0] if len(items) == 1 else {"results": items}
            return {"error": "No content"}
        except Exception as e:
            logger.error(f"Tool invocation failed: {e}")
            return {"error": f"Tool call failed: {str(e)}"}

    def plan_tools(self, user_query: str) -> dict:
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT_PLAN},
            {"role": "user", "content": user_query},
        ]
        content = (self._call_azure_openai(messages, temperature=0.1) or "").strip()
        if content.startswith("```"):
            cleaned = content.strip("`")
            if cleaned.lower().startswith("json"):
                cleaned = cleaned[4:].strip()
            cleaned = cleaned.replace("```", "").strip()
        else:
            cleaned = content
        try:
            plan = json.loads(cleaned)
            return plan if isinstance(plan, dict) and "plan" in plan else {"plan": []}
        except json.JSONDecodeError:
            logger.warning(f"Plan parse failed. Raw:\n{content}")
            # Try to extract JSON from malformed response
            try:
                import re
                json_match = re.search(r'\{.*\}', content, re.DOTALL)
                if json_match:
                    plan = json.loads(json_match.group())
                    return plan if isinstance(plan, dict) and "plan" in plan else {"plan": []}
            except:
                pass
            return {"plan": []}

    def summarize_results(self, user_query: str, plan: list, results: list) -> str:
        if not plan:
            return "No tools were planned for this query. Please try rephrasing your question."
        
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT_SUMMARIZE},
            {"role": "user", "content": f"Question:\n{user_query}"},
            {"role": "assistant", "content": f"Plan:\n{json.dumps(plan, indent=2)}"},
            {"role": "assistant", "content": f"Results:\n{json.dumps(results, indent=2)}"},
        ]
        summary = self._call_azure_openai(messages, temperature=0.3) or ""
        
        # Fallback if summary is empty or error
        if not summary or summary.startswith("Error calling Azure OpenAI"):
            try:
                summary = f"Based on the data:\n\n"
                for i, result in enumerate(results):
                    for tool, data in result.items():
                        summary += f"**{tool}**: {str(data)[:200]}...\n\n"
            except:
                summary = "Received data but couldn't generate summary. Please check the tool results above."
        
        return summary
