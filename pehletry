                borderRadius: 4, 
                fontSize: 12, 
                backgroundColor: statusColor,
                color: "white"
              }}>
                {r.status || "running"}
              </span>
            </div>
            
            {r.args && Object.keys(r.args).length > 0 && (
              <div style={{ marginTop: 4 }}>
                <strong>Args:</strong> <code style={{ fontSize: 12, backgroundColor: "#f5f5f5", padding: "2px 4px" }}>
