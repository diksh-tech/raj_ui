import os
import json
import logging
import asyncio
import uuid
from typing import Any, Dict, List
from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse
from dotenv import load_dotenv

from client import FlightOpsMCPClient
from agui import (
    ndjson,
    text_start,
    text_content,
    text_end,
    tool_start,
    tool_args,
    tool_result,
    tool_end,
    state_delta,
)

load_dotenv()
logging.basicConfig(level=os.getenv("LOG_LEVEL", "INFO"))
logger = logging.getLogger("FlightOps.FastAPI")

# ---------------------------------------------------------------------------
# Global setup
# ---------------------------------------------------------------------------
app = FastAPI(title="FlightOps AG-UI Backend")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # frontend (React/Vite)
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

mcp_client = FlightOpsMCPClient()


@app.on_event("startup")
async def startup_event():
    """Ensure MCP client connects once on server start."""
    await mcp_client.connect()
    logger.info("✅ MCP Client connected on startup.")


@app.on_event("shutdown")
async def shutdown_event():
    """Gracefully disconnect MCP client."""
    await mcp_client.disconnect()
    logger.info("🛑 MCP Client disconnected.")


# ---------------------------------------------------------------------------
# AG-UI chat endpoint (main event stream)
# ---------------------------------------------------------------------------
@app.post("/agui/chat")
async def agui_chat(request: Request):
    """
    Main AG-UI endpoint that streams NDJSON events (text + tool calls).
    - Receives user message
    - Plans tool calls using Azure LLM
    - Executes each MCP tool (unique toolCallId per call)
    - Summarizes and streams response chunks
    """

    async def event_stream():
        body = await request.json()
        messages = body.get("messages", [])
        user_msg = messages[-1]["content"] if messages else ""
        msg_id = str(uuid.uuid4())  # assistant messageId for text stream
        results = []

        logger.info(f"User query: {user_msg}")

        # 1️⃣ start assistant message
        yield ndjson(text_start(msg_id))

        # 2️⃣ LLM planning
        yield ndjson(state_delta([{"op": "add", "path": "/status", "value": "planning"}]))
        plan_data = mcp_client.plan_tools(user_msg)
        plan = plan_data.get("plan", [])

        yield ndjson(state_delta([{"op": "add", "path": "/lastPlan", "value": plan}]))

        if not plan:
            logger.warning("❌ No plan generated by LLM.")
            yield ndjson(text_content(msg_id, "Sorry, I couldn't understand the query."))
            yield ndjson(text_end(msg_id))
            return

        # 3️⃣ Sequential tool execution (unique toolCallId per call)
        yield ndjson(state_delta([{"op": "add", "path": "/status", "value": "executing"}]))

        for idx, step in enumerate(plan):
            tool = step.get("tool")
            args = (step.get("arguments") or {})
            args = {k: v for k, v in args.items() if v not in (None, "", "unknown")}

            # ✅ generate unique toolCallId per tool
            tool_call_id = str(uuid.uuid4())
            debug_args = dict(args)
            debug_args["_callIndex"] = idx

            yield ndjson(tool_start(tool_call_id, tool))
            yield ndjson(tool_args(tool_call_id, debug_args))

            try:
                resp = await mcp_client.invoke_tool(tool, args)
                yield ndjson(tool_result(tool_call_id, resp))
                yield ndjson(tool_end(tool_call_id, True))
                results.append({tool: resp})
            except Exception as e:
                err = {"error": str(e)}
                yield ndjson(tool_result(tool_call_id, err))
                yield ndjson(tool_end(tool_call_id, False))
                results.append({tool: err})

        # 4️⃣ Summarization
        yield ndjson(state_delta([{"op": "add", "path": "/status", "value": "summarizing"}]))

        summary = ""
        try:
            summary = mcp_client.summarize_results(user_msg, plan, results).get("summary", "")
        except Exception as e:
            summary = f"(Summarization error) {e}"

        if not isinstance(summary, str):
            try:
                summary = json.dumps(summary, ensure_ascii=False)
            except Exception:
                summary = str(summary)

        if not summary.strip():
            fallback = json.dumps(results[:2], indent=2, ensure_ascii=False)
            summary = "No model summary available. Showing top results:\n\n" + fallback

        # Debug preview (optional)
        yield ndjson(state_delta([{"op": "add", "path": "/debug/summaryPreview", "value": summary[:400]}]))

        # 5️⃣ Stream final summary text to frontend
        CHUNK = 800
        for i in range(0, len(summary), CHUNK):
            yield ndjson(text_content(msg_id, summary[i:i+CHUNK]))

        yield ndjson(text_end(msg_id))
        yield ndjson(state_delta([{"op": "add", "path": "/status", "value": "done"}]))

    return StreamingResponse(event_stream(), media_type="application/x-ndjson")


