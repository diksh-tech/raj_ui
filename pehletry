import json, logging
from typing import AsyncGenerator

from fastapi import FastAPI, Request, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse

from agui import ndjson, text_start, text_content, text_end, tool_start, tool_args, tool_result, tool_end, state_delta, new_ids
from client_runner import FlightOpsMCPClient

logger = logging.getLogger("FlightOps.AGUI")
logging.basicConfig(level="INFO")

app = FastAPI(title="FlightOps AG-UI Backend")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173","http://127.0.0.1:5173","*"],
    allow_credentials=True, allow_methods=["*"], allow_headers=["*"],
)

mcp_client = FlightOpsMCPClient()

@app.on_event("startup")
async def _startup():
    try:
        await mcp_client.connect()
        logger.info("MCP client connected on startup")
    except Exception as e:
        logger.error(f"MCP connect failed on startup: {e}")

@app.get("/health")
async def health_check():
    try:
        tools = await mcp_client.list_tools()
        return {"status": "healthy", "tools_available": len(tools.get("tools", {}))}
    except Exception as e:
        return {"status": "unhealthy", "error": str(e)}, 503

@app.post("/agui/chat")
async def agui_chat(req: Request):
    body = await req.json()
    messages = body.get("messages", [])
    user_msg = messages[-1]["content"] if messages else ""
    _ = body.get("state", {})

    if not user_msg:
        raise HTTPException(status_code=400, detail="No user message provided")

    async def stream() -> AsyncGenerator[bytes, None]:
        msg_id, _ = new_ids()

        # 1) start
        yield ndjson(text_start(msg_id))

        # 2) plan
        plan_data = mcp_client.plan_tools(user_msg)
        plan = plan_data.get("plan", [])
        yield ndjson(state_delta([{"op":"add","path":"/lastPlan","value":plan}]))
        
        if not plan:
            yield ndjson(text_content(msg_id, "I couldn't determine which tools to use for your query. Please try rephrasing with specific flight details or analytics requests."))
            yield ndjson(text_end(msg_id))
            return

        # 3) run tools
        results = []
        for step in plan:
            tool = step.get("tool", "")
            args = (step.get("arguments") or {})
            args = {k: v for k, v in args.items() if v not in (None, "", "unknown")}

            if not tool:
                continue

            tool_id = f"{msg_id}_{tool}"
            yield ndjson(tool_start(tool_id, tool))
            yield ndjson(tool_args(tool_id, args))
            try:
                resp = await mcp_client.invoke_tool(tool, args)
                results.append({tool: resp})
                yield ndjson(tool_result(tool_id, resp))
                yield ndjson(tool_end(tool_id, True))
            except Exception as e:
                err = {"error": str(e)}
                results.append({tool: err})
                yield ndjson(tool_result(tool_id, err))
                yield ndjson(tool_end(tool_id, False))

        # 4) summarize
        summary = mcp_client.summarize_results(user_msg, plan, results)

        # Ensure summary is string and not empty
        if not isinstance(summary, str):
            try:
                summary = json.dumps(summary, ensure_ascii=False)
            except:
                summary = str(summary)
        
        if not summary.strip():
            summary = "No summary available. Please check the tool results above."

        # Debug preview
        yield ndjson(state_delta([{"op":"add","path":"/debug/summaryPreview","value":summary[:400] + "..." if len(summary) > 400 else summary}]))

        # Chunked content
        CHUNK = 800
        for i in range(0, len(summary), CHUNK):
            yield ndjson(text_content(msg_id, summary[i:i+CHUNK]))

        yield ndjson(text_end(msg_id))

    return StreamingResponse(stream(), media_type="application/x-ndjson")
