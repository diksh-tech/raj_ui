export default function ToolStatus({ runs }) {
  const ids = Object.keys(runs);
  if (!ids.length) return null;
  
  return (
    <div style={{ margin: "12px 0", padding: 12, border: "1px solid #e0e0e0", borderRadius: 8, backgroundColor: "#fffde7" }}>
