import { useState } from "react";
import { aguiStream } from "./aguiClient";
import Chat from "./components/Chat";
import ToolStatus from "./components/ToolStatus";

const BACKEND_URL = "http://localhost:8001/agui/chat";

export default function App() {
  const [messages, setMessages] = useState([]);
  const [toolRuns, setToolRuns] = useState({});
  const [input, setInput] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");

  const appendAssistantChunk = (messageId, chunk) => {
    const safeText = typeof chunk === "string" ? chunk : JSON.stringify(chunk, null, 2);
    setMessages((m) => {
      const copy = [...m];
      const idx = copy.findIndex(x => x.messageId === messageId && x.role === "assistant");
      if (idx === -1) {
        copy.push({ role: "assistant", content: safeText, messageId });
      } else {
        copy[idx] = { ...copy[idx], content: (copy[idx].content || "") + safeText };
      }
      return copy;
    });
  };

  const send = async () => {
    if (!input.trim() || busy) return;
    
    setBusy(true);
    setError("");
    const userMsg = { role: "user", content: input.trim() };
    setMessages((m) => [...m, userMsg]);
    setInput("");
    setToolRuns({}); // Clear previous tool runs

    try {
      const payload = { 
        messages: [...messages, userMsg], 
        state: {} 
      };
      
      for await (const ev of aguiStream(BACKEND_URL, payload)) {
        console.log("AGUI Event:", ev);
        
        switch (ev.type) {
          case "TEXT_MESSAGE_START":
            setMessages((m) => [...m, { 
              role: "assistant", 
              content: "", 
              messageId: ev.messageId 
            }]);
            break;
            
          case "TEXT_MESSAGE_CONTENT":
            appendAssistantChunk(ev.messageId, ev.text || "");
            break;
            
          case "TEXT_MESSAGE_END":
            break;

          case "TOOL_CALL_START":
            setToolRuns((t) => ({ 
              ...t, 
              [ev.toolCallId]: { 
                name: ev.name, 
                status: "running",
                args: null,
                result: null
              } 
            }));
            break;
            
          case "TOOL_CALL_ARGS":
            setToolRuns((t) => ({ 
              ...t, 
              [ev.toolCallId]: { 
                ...t[ev.toolCallId], 
                args: ev.args 
              } 
            }));
            break;
            
          case "TOOL_CALL_RESULT":
            setToolRuns((t) => ({ 
              ...t, 
              [ev.toolCallId]: { 
                ...t[ev.toolCallId], 
                result: ev.result 
              } 
            }));
            break;
            
          case "TOOL_CALL_END":
            setToolRuns((t) => ({ 
              ...t, 
              [ev.toolCallId]: { 
                ...t[ev.toolCallId], 
                status: ev.ok ? "ok" : "error" 
              } 
            }));
            break;

          case "STATE_DELTA":
            // Optional: handle state changes if needed
            break;
            
          default:
            console.warn("Unknown event type:", ev.type);
        }
      }
    } catch (e) {
      console.error("Stream error:", e);
      setError(`Connection error: ${e.message}`);
      setMessages((m) => [...m, { 
        role: "assistant", 
        content: `Sorry, I encountered an error: ${e.message}` 
      }]);
    } finally {
      setBusy(false);
    }
  };

  return (
    <div style={{ 
      maxWidth: 900, 
      margin: "0 auto", 
      padding: 24,
      fontFamily: "system-ui, sans-serif",
      minHeight: "100vh",
      backgroundColor: "#fafafa"
    }}>
      <header style={{ marginBottom: 32, textAlign: "center" }}>
        <h1 style={{ color: "#1565c0", margin: 0 }}>FlightOps — AG-UI</h1>
        <p style={{ color: "#666", margin: "8px 0 0 0" }}>
          Ask questions about flight operations data
        </p>
      </header>

      {error && (
        <div style={{ 
          padding: 12, 
          backgroundColor: "#ffebee", 
          border: "1px solid #f44336",
          borderRadius: 8,
          marginBottom: 16,
          color: "#c62828"
        }}>
          {error}
        </div>
      )}

      <Chat messages={messages} />
      
      <ToolStatus runs={toolRuns} />
      
      {busy && (
        <div style={{ 
          padding: 12, 
          textAlign: "center", 
          color: "#666",
          fontStyle: "italic" 
        }}>
          Processing... (Using MCP tools)
        </div>
      )}

      <div style={{ 
        display: "flex", 
        gap: 8, 
        marginTop: 24,
        position: "sticky",
        bottom: 24,
        backgroundColor: "white",
        padding: 16,
        borderRadius: 8,
        border: "1px solid #e0e0e0",
        boxShadow: "0 2px 8px rgba(0,0,0,0.1)"
      }}>
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          placeholder="Ask about flight data, delays, equipment, analytics..."
          style={{ 
            flex: 1, 
            padding: "12px 16px",
            border: "1px solid #ddd",
            borderRadius: 8,
            fontSize: 16
          }}
          onKeyDown={(e) => e.key === "Enter" && send()}
          disabled={busy}
        />
        <button 
          onClick={send} 
          disabled={busy || !input.trim()} 
          style={{ 
            padding: "12px 24px",
            backgroundColor: busy ? "#ccc" : "#1565c0",
            color: "white",
            border: "none",
            borderRadius: 8,
            fontSize: 16,
            cursor: busy ? "not-allowed" : "pointer"
          }}
        >
          {busy ? "Working..." : "Send"}
        </button>
      </div>
    </div>
  );
}
