import React, { useState, useRef, useEffect } from 'react';

const EventStreamViewer = ({ events }) => {
  const [activeTab, setActiveTab] = useState('all');
  const [autoScroll, setAutoScroll] = useState(true);
  const endRef = useRef(null);

  useEffect(() => {
    if (autoScroll && endRef.current) {
      endRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [events, autoScroll]);

  const renderEventContent = (event) => {
    switch (event.type) {
      case 'run_start':
        return (
          <div style={{ color: '#3b82f6', display: 'flex', alignItems: 'center', gap: 8 }}>
            <div style={{ fontSize: '1.2em' }}>🚀</div>
            <div>
              <strong>Starting query execution</strong>
              <div style={{ fontSize: 14, color: '#64748b', marginTop: 4 }}>
                "{event.data.query}"
              </div>
            </div>
          </div>
        );

      case 'plan_generation':
        if (event.data.status === 'started') {
          return (
            <div style={{ color: '#f59e0b', display: 'flex', alignItems: 'center', gap: 8 }}>
              <div style={{ fontSize: '1.2em' }}>📋</div>
              <div>
                <strong>Generating execution plan...</strong>
              </div>
            </div>
          );
        } else {
          return (
            <div style={{ color: '#10b981', display: 'flex', alignItems: 'center', gap: 8 }}>
              <div style={{ fontSize: '1.2em' }}>✅</div>
              <div>
                <strong>Execution plan generated</strong>
                <div style={{ fontSize: 14, color: '#64748b', marginTop: 4 }}>
                  {event.data.message}
                </div>
                {event.data.plan && (
                  <div style={{ marginTop: 8 }}>
                    {event.data.plan.map((step, index) => (
                      <div key={index} style={{ 
                        background: '#f8fafc', 
                        padding: 8, 
                        borderRadius: 6, 
                        marginTop: 4,
                        borderLeft: '3px solid #3b82f6'
                      }}>
                        <div><strong>Step {index + 1}:</strong> {step.tool}</div>
                        {step.arguments && Object.keys(step.arguments).length > 0 && (
                          <div style={{ fontSize: 12, color: '#64748b', marginTop: 4 }}>
                            Arguments: {JSON.stringify(step.arguments)}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        }

      case 'tool_start':
        return (
          <div style={{ color: '#8b5cf6', display: 'flex', alignItems: 'center', gap: 8 }}>
            <div style={{ fontSize: '1.2em' }}>🛠️</div>
            <div>
              <strong>Executing tool {event.data.step}/{event.data.total_steps}</strong>
              <div style={{ fontSize: 14, color: '#64748b', marginTop: 4 }}>
                Tool: <code>{event.data.tool}</code>
              </div>
            </div>
          </div>
        );

      case 'tool_result':
        const result = event.data.result;
        return (
          <div style={{ color: '#10b981', display: 'flex', alignItems: 'flex-start', gap: 8 }}>
            <div style={{ fontSize: '1.2em' }}>✅</div>
            <div style={{ flex: 1 }}>
              <strong>Tool completed</strong>
              <div style={{ fontSize: 14, color: '#64748b', marginTop: 4 }}>
                Tool: <code>{event.data.tool}</code>
              </div>
              {result && (
                <div style={{ marginTop: 8 }}>
                  {result.error ? (
                    <div style={{ 
                      background: '#fef2f2', 
                      padding: 12, 
                      borderRadius: 6,
                      border: '1px solid #fecaca',
                      color: '#dc2626'
                    }}>
                      <strong>Error:</strong> {result.error}
                    </div>
                  ) : result.data ? (
                    <pre style={{ 
                      background: '#1e293b', 
                      color: 'white', 
                      padding: 12, 
                      borderRadius: 6, 
                      overflow: 'auto',
                      fontSize: 12,
                      marginTop: 8,
                      maxHeight: 200
                    }}>
                      {JSON.stringify(result.data, null, 2)}
                    </pre>
                  ) : (
                    <div style={{ 
                      background: '#f8fafc', 
                      padding: 12, 
                      borderRadius: 6,
                      color: '#64748b',
                      fontSize: 14
                    }}>
                      No data returned
