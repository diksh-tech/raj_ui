import React, { useState, useEffect, useRef } from "react";
import EventStreamViewer from "./components/EventStreamViewer.jsx";

const AGENT_ENDPOINT = import.meta.env.VITE_AGENT_ENDPOINT || "http://localhost:8001/agent";

export default function App() {
  const [query, setQuery] = useState("");
  const [events, setEvents] = useState([]);
  const [loading, setLoading] = useState(false);
  const [connectionStatus, setConnectionStatus] = useState("disconnected");
  const eventSourceRef = useRef(null);

  function pushEvent(event) {
    setEvents(prev => [...prev, event]);
  }

  function clearEvents() {
    setEvents([]);
  }

  async function startRun() {
    if (!query.trim()) {
      alert("Please enter a question");
      return;
    }

    setLoading(true);
    setConnectionStatus("connecting");
    clearEvents();

    const threadId = `thread-${Date.now()}`;
    const runId = `run-${Date.now()}`;

    try {
      // Using EventSource for SSE
      const url = `${AGENT_ENDPOINT}?${new URLSearchParams({
        thread_id: threadId,
        run_id: runId
      })}`;

      eventSourceRef.current = new EventSource(url, {
        withCredentials: false
      });

      eventSourceRef.current.onopen = () => {
        setConnectionStatus("connected");
        console.log("SSE connection opened");
      };

      eventSourceRef.current.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          pushEvent(data);
          
          // Update connection status based on event type
          if (data.type === "run_complete" || data.type === "error") {
            setLoading(false);
            setConnectionStatus("completed");
            if (eventSourceRef.current) {
              eventSourceRef.current.close();
            }
          }
        } catch (error) {
          console.error("Error parsing SSE event:", error);
        }
      };

      eventSourceRef.current.onerror = (error) => {
        console.error("SSE error:", error);
        setConnectionStatus("error");
        setLoading(false);
        
        pushEvent({
          type: "error",
          data: {
            message: "Connection error occurred",
            timestamp: new Date().toISOString()
          }
        });

        if (eventSourceRef.current) {
          eventSourceRef.current.close();
        }
      };

      // Send the initial request
      const response = await fetch(AGENT_ENDPOINT, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          query: query,
          thread_id: threadId,
          run_id: runId
        })
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${await response.text()}`);
      }

    } catch (error) {
      console.error("Failed to start run:", error);
      setConnectionStatus("error");
      setLoading(false);
      
      pushEvent({
        type: "error", 
        data: {
          message: `Failed to start: ${error.message}`,
          timestamp: new Date().toISOString()
        }
      });
    }
  }

  function stopRun() {
    if (eventSourceRef.current) {
      eventSourceRef.current.close();
      eventSourceRef.current = null;
    }
    setLoading(false);
    setConnectionStatus("disconnected");
    
    pushEvent({
      type: "run_stopped",
      data: {
        message: "Run stopped by user",
        timestamp: new Date().toISOString()
      }
    });
  }

  // Cleanup on unmount
  useEffect(() => {
    return () => {
      if (eventSourceRef.current) {
        eventSourceRef.current.close();
      }
    };
  }, []);

  const exampleQueries = [
    "Show me all flights from Delhi to Mumbai yesterday",
    "What was the average delay for flight 6E-215?",
    "How many passengers were on flight AI-101 on 2024-06-23?",
    "List all flights with delays greater than 30 minutes",
    "What is the fuel consumption for flight 6E-215?",
    "Show crew information for flight AI-101",
    "Find flights that were cancelled last week",
    "What is the on-time performance for flight 6E-215?"
  ];

  const handleExampleClick = (exampleQuery) => {
    setQuery(exampleQuery);
  };

  const connectionStatusColors = {
    disconnected: "#6b7280",
    connecting: "#f59e0b",
    connected: "#10b981",
    error: "#ef4444",
    completed: "#3b82f6"
  };

  return (
    <div style={{ 
      padding: 20, 
      fontFamily: "Inter, sans-serif", 
      maxWidth: 1200, 
      margin: '0 auto',
      backgroundColor: '#f8fafc',
      minHeight: '100vh'
    }}>
      {/* Header */}
      <div style={{ 
        background: 'white', 
        padding: 24, 
        borderRadius: 12, 
        boxShadow: '0 4px 6px -1px rgba(0,0,0,0.1)',
        marginBottom: 24
      }}>
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: 16 }}>
          <div>
            <h1 style={{ 
              margin: 0, 
              color: '#1e293b',
              display: 'flex',
              alignItems: 'center',
              gap: 12
            }}>
              <span style={{ fontSize: '1.5em' }}>✈️</span>
              FlightOps — AG-UI Client
            </h1>
            <p style={{ 
              margin: '8px 0 0 0', 
              color: '#64748b',
              fontSize: 16
            }}>
              Ask flight operations questions and watch real-time execution
            </p>
          </div>
          
          <div style={{ 
            display: 'flex', 
            alignItems: 'center', 
            gap: 12,
            background: '#f1f5f9',
            padding: '8px 16px',
            borderRadius: 8
          }}>
            <div style={{
              width: 8,
              height: 8,
              borderRadius: '50%',
              backgroundColor: connectionStatusColors[connectionStatus],
              animation: connectionStatus === 'connecting' ? 'pulse 1.5s infinite' : 'none'
            }} />
            <span style={{ 
              fontSize: 14, 
              color: '#475569',
              textTransform: 'capitalize'
            }}>
              {connectionStatus}
            </span>
          </div>
        </div>
      </div>

      <div style={{ display: 'grid', gap: 24, gridTemplateColumns: '1fr 1fr' }}>
        {/* Left Column - Input and Examples */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 24 }}>
          {/* Query Input */}
          <div style={{ 
            background: 'white', 
            padding: 24, 
            borderRadius: 12, 
            boxShadow: '0 4px 6px -1px rgba(0,0,0,0.1)'
          }}>
            <h3 style={{ margin: '0 0 16px 0', color: '#1e293b' }}>Ask a Question</h3>
            <textarea
              rows={5}
              style={{ 
                width: "100%", 
                fontSize: 16, 
                padding: 16,
                border: '2px solid #e2e8f0',
                borderRadius: 8,
                fontFamily: 'inherit',
                resize: 'vertical',
                outline: 'none',
                transition: 'border-color 0.2s'
              }}
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Why was flight 6E215 delayed on June 23, 2024? 🛫"
              disabled={loading}
              onFocus={(e) => e.target.style.borderColor = '#3b82f6'}
              onBlur={(e) => e.target.style.borderColor = '#e2e8f0'}
            />
            
            <div style={{ 
              display: 'flex', 
              gap: 12, 
              marginTop: 16,
              flexWrap: 'wrap'
            }}>
              <button 
                onClick={startRun}
                disabled={loading || !query.trim()}
                style={{
                  padding: '12px 24px',
                  background: loading ? '#9ca3af' : '#3b82f6',
                  color: 'white',
                  border: 'none',
                  borderRadius: 8,
                  cursor: loading ? 'not-allowed' : 'pointer',
                  fontSize: 14,
                  fontWeight: 600,
                  transition: 'all 0.2s',
                  opacity: loading || !query.trim() ? 0.6 : 1
                }}
                onMouseOver={(e) => {
                  if (!loading && query.trim()) {
                    e.target.style.transform = 'translateY(-1px)';
                    e.target.style.boxShadow = '0 4px 12px rgba(59, 130, 246, 0.4)';
                  }
                }}
                onMouseOut={(e) => {
                  e.target.style.transform = 'translateY(0)';
                  e.target.style.boxShadow = 'none';
                }}
              >
                {loading ? (
                  <span style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                    <div style={{ 
                      width: 16, 
                      height: 16, 
                      border: '2px solid transparent',
                      borderTop: '2px solid white',
                      borderRadius: '50%',
                      animation: 'spin 1s linear infinite'
                    }} />
                    Processing...
                  </span>
                ) : (
                  '🚀 Run Query'
                )}
              </button>
              
              {loading && (
                <button 
                  onClick={stopRun}
                  style={{
                    padding: '12px 24px',
                    background: '#ef4444',
                    color: 'white',
                    border: 'none',
                    borderRadius: 8,
                    cursor: 'pointer',
                    fontSize: 14,
                    fontWeight: 600
                  }}
                >
                  ⏹️ Stop
                </button>
              )}
              
              <button 
                onClick={clearEvents}
                style={{
                  padding: '12px 24px',
                  background: '#6b7280',
                  color: 'white',
                  border: 'none',
                  borderRadius: 8,
                  cursor: 'pointer',
                  fontSize: 14,
                  fontWeight: 600
                }}
              >
                🗑️ Clear
              </button>
            </div>
          </div>

          {/* Example Queries */}
          <div style={{ 
            background: 'white', 
            padding: 24, 
            borderRadius: 12, 
            boxShadow: '0 4px 6px -1px rgba(0,0,0,0.1)'
          }}>
            <h3 style={{ margin: '0 0 16px 0', color: '#1e293b' }}>Example Queries</h3>
            <div style={{ display: 'grid', gap: 12 }}>
              {exampleQueries.map((example, index) => (
                <button
                  key={index}
                  onClick={() => handleExampleClick(example)}
                  disabled={loading}
                  style={{
                    background: '#f8fafc',
                    color: '#374151',
                    border: '1px solid #e2e8f0',
                    textAlign: 'left',
                    padding: 16,
                    fontSize: 14,
                    borderRadius: 8,
                    cursor: loading ? 'not-allowed' : 'pointer',
                    fontFamily: 'inherit',
                    transition: 'all 0.2s',
                    opacity: loading ? 0.6 : 1
                  }}
                  onMouseOver={(e) => {
                    if (!loading) {
                      e.target.style.background = '#f1f5f9';
                      e.target.style.borderColor = '#3b82f6';
                    }
                  }}
                  onMouseOut={(e) => {
                    if (!loading) {
                      e.target.style.background = '#f8fafc';
                      e.target.style.borderColor = '#e2e8f0';
                    }
                  }}
                >
                  {example}
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* Right Column - Event Stream */}
        <div style={{ 
          background: 'white', 
          borderRadius: 12, 
          boxShadow: '0 4px 6px -1px rgba(0,0,0,0.1)',
          display: 'flex',
          flexDirection: 'column',
          height: 'fit-content',
          maxHeight: '80vh'
        }}>
          <EventStreamViewer events={events} />
        </div>
      </div>

      <style>{`
        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
        @keyframes pulse {
          0%, 100% { opacity: 1; }
          50% { opacity: 0.5; }
        }
      `}</style>
    </div>
  );
}
