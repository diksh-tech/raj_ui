      case 'tool_error':
        return (
          <div style={{ color: '#ef4444', display: 'flex', alignItems: 'flex-start', gap: 8 }}>
            <div style={{ fontSize: '1.2em' }}>❌</div>
            <div style={{ flex: 1 }}>
              <strong>Tool execution failed</strong>
              <div style={{ fontSize: 14, color: '#64748b', marginTop: 4 }}>
                Tool: <code>{event.data.tool}</code>
              </div>
              <div style={{ 
                background: '#fef2f2', 
                padding: 12, 
                borderRadius: 6,
                border: '1px solid #fecaca',
                color: '#dc2626',
                marginTop: 8
              }}>
                <strong>Error:</strong> {event.data.error}
              </div>
            </div>
          </div>
        );

      case 'summary_generation':
        if (event.data.status === 'started') {
          return (
            <div style={{ color: '#f59e0b', display: 'flex', alignItems: 'center', gap: 8 }}>
              <div style={{ fontSize: '1.2em' }}>📊</div>
              <div>
                <strong>Generating summary...</strong>
              </div>
            </div>
          );
        } else {
          return (
            <div style={{ color: '#10b981', display: 'flex', alignItems: 'flex-start', gap: 8 }}>
              <div style={{ fontSize: '1.2em' }}>📊</div>
              <div style={{ flex: 1 }}>
                <strong>Summary generated</strong>
                {event.data.summary && (
                  <div style={{ 
                    background: '#f0f9ff', 
                    padding: 16, 
                    borderRadius: 8,
                    border: '1px solid #bae6fd',
                    marginTop: 8
                  }}>
                    <div style={{ lineHeight: 1.6, color: '#0369a1' }}>
                      {event.data.summary.summary || 'No summary available'}
                    </div>
                  </div>
                )}
              </div>
            </div>
          );
        }

      case 'run_complete':
