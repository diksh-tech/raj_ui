async def interact_with_mcp_tools(user_prompt: str) -> AsyncGenerator[bytes, None]:
    """Main orchestration generator that yields AG-UI events for streaming."""
    msg_id, _ = new_ids()

    try:
        logger.info(f"\n{'='*60}")
        logger.info(f"🟡 NEW REQUEST: {user_prompt}")
        logger.info(f"{'='*60}")

        # Start assistant message
        yield ndjson(text_start(msg_id))

        # Step 1: Plan tools using Azure OpenAI
        plan_data = mcp_client.plan_tools(user_prompt)
        plan = plan_data.get("plan", [])
        
        yield ndjson(state_delta([{
            "op": "add", 
            "path": "/lastPlan", 
            "value": plan
        }]))

        if not plan:
            error_msg = (
                "I couldn't determine which tools to use for your query. "
                "Please try asking about specific flights using carrier, flight number, and date. "
                "Example: 'Get basic info for IndiGo flight 6E 101 on 2024-12-01'"
            )
            yield ndjson(text_content(msg_id, error_msg))
            yield ndjson(text_end(msg_id))
            return

        # Step 2: Execute tools
        results = []
        for i, step in enumerate(plan):
            tool_name = step.get("tool", "")
            args = step.get("arguments", {})
            
            if not tool_name:
                continue

            # Clean arguments
            args = {k: v for k, v in args.items() if v not in (None, "", "unknown")}
            
            tool_id = f"{msg_id}_{i}"
            
            # Tool call start
            yield ndjson(tool_start(tool_id, tool_name))
            yield ndjson(tool_args(tool_id, args))
            
            logger.info(f"🔧 Calling tool: {tool_name} with args: {args}")
            
            try:
                # Execute tool with progress indication
                progress_msg = f"Executing {tool_name}..."
                yield ndjson(text_content(msg_id, progress_msg))
                
                tool_result_data = await mcp_client.invoke_tool(tool_name, args)
                results.append({tool_name: tool_result_data})
                
                logger.info(f"✅ Tool {tool_name} completed successfully")
                
                yield ndjson(tool_result(tool_id, tool_result_data))
                yield ndjson(tool_end(tool_id, True))
                
            except Exception as e:
                error_msg = f"Tool execution failed: {str(e)}"
                logger.error(f"❌ {error_msg}")
                error_result = {"error": error_msg}
                results.append({tool_name: error_result})
                
                yield ndjson(tool_result(tool_id, error_result))
                yield ndjson(tool_end(tool_id, False))

        # Step 3: Generate intelligent summary
        summary = mcp_client.summarize_results(user_prompt, plan, results)
        
        # Ensure summary is string
        if not isinstance(summary, str):
            summary = str(summary)
        
        # Stream summary in chunks for better UX
        CHUNK_SIZE = 500
        logger.info(f"📝 Streaming summary ({len(summary)} characters)")
        
        for i in range(0, len(summary), CHUNK_SIZE):
            chunk = summary[i:i+CHUNK_SIZE]
            yield ndjson(text_content(msg_id, chunk))
            
            # Progress logging
            if (i + CHUNK_SIZE) % 2000 == 0:
                logger.info(f"  📤 Streamed {min(i + CHUNK_SIZE, len(summary))}/{len(summary)} chars")

        logger.info("✅ Conversation complete!")

    except Exception as e:
        error_msg = f"Error processing request: {str(e)}"
        logger.error(f"❌ {error_msg}")
        traceback.print_exc()
        yield ndjson(text_content(msg_id, error_msg))

    finally:
        yield ndjson(text_end(msg_id))

@app.post("/agui/chat")
async def agui_chat(request: Request):
    """AG-UI chat endpoint with enhanced streaming response"""
    try:
        body = await request.json()
        messages = body.get("messages", [])
        user_msg = messages[-1]["content"] if messages else ""
        
        if not user_msg:
            raise HTTPException(status_code=400, detail="No user message provided")

        async def event_generator():
            try:
                async for event in interact_with_mcp_tools(user_msg):
                    yield event
                    # Small delay to ensure proper streaming
                    await asyncio.sleep(0.001)
            except Exception as e:
                logger.error(f"❌ Generator error: {e}")
                traceback.print_exc()
                error_msg = f"Streaming error: {str(e)}"
                yield ndjson(text_content("error", error_msg))

        return StreamingResponse(
            event_generator(),
            media_type="application/x-ndjson",
            headers={
                "Cache-Control": "no-cache, no-transform",
                "Connection": "keep-alive",
                "X-Accel-Buffering": "no",
            },
        )

    except Exception as e:
        logger.error(f"❌ Error in agui_chat: {e}")
        raise HTTPException(status_code=500, detail=str(e))

