import { useState, useRef, useEffect } from 'react';
import { aguiStream } from './aguiClient';
import Chat from './components/Chat';
import ToolStatus from './components/ToolStatus';

const BACKEND_URL = "http://localhost:8001/agui/chat";

export default function App() {
  const [messages, setMessages] = useState([]);
  const [toolRuns, setToolRuns] = useState({});
  const [input, setInput] = useState('');
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  const [connectionStatus, setConnectionStatus] = useState('disconnected');
  const messagesEndRef = useRef(null);

  // Check backend health on component mount
  useEffect(() => {
    checkBackendHealth();
  }, []);

  const checkBackendHealth = async () => {
    try {
      const response = await fetch('http://localhost:8001/health');
      const data = await response.json();
      setConnectionStatus(data.mcp_server === 'connected' ? 'connected' : 'degraded');
    } catch (err) {
      setConnectionStatus('disconnected');
      console.error('Health check failed:', err);
    }
  };

  const appendAssistantChunk = (messageId, chunk) => {
    const safeText = typeof chunk === 'string' ? chunk : JSON.stringify(chunk, null, 2);
    
    setMessages((prevMessages) => {
      const messageIndex = prevMessages.findIndex(
        msg => msg.messageId === messageId && msg.role === 'assistant'
      );

      if (messageIndex === -1) {
        // New assistant message
        return [...prevMessages, { 
          role: 'assistant', 
          content: safeText, 
          messageId 
        }];
      } else {
        // Append to existing assistant message
        const updatedMessages = [...prevMessages];
        updatedMessages[messageIndex] = {
          ...updatedMessages[messageIndex],
          content: (updatedMessages[messageIndex].content || '') + safeText
        };
        return updatedMessages;
      }
    });
  };

  const sendMessage = async () => {
    if (!input.trim() || busy) return;
    
    const userMessage = input.trim();
    setInput('');
    setError('');
    setBusy(true);
    setToolRuns({}); // Clear previous tool runs

    // Add user message to chat
    const userMsg = { role: 'user', content: userMessage, messageId: `user_${Date.now()}` };
    setMessages(prev => [...prev, userMsg]);

    try {
      const payload = { 
        messages: [...messages, userMsg], 
        state: {} 
      };

      console.log('📤 Sending payload:', payload);

      for await (const event of aguiStream(BACKEND_URL, payload)) {
        console.log('📨 Processing event:', event);
        
        switch (event.type) {
          case "TEXT_MESSAGE_START":
            setMessages(prev => [...prev, { 
              role: 'assistant', 
              content: '', 
              messageId: event.messageId 
            }]);
            break;
            
          case "TEXT_MESSAGE_CONTENT":
            appendAssistantChunk(event.messageId, event.text || '');
            break;
            
          case "TEXT_MESSAGE_END":
            // Message complete, no action needed
            break;

          case "TOOL_CALL_START":
            setToolRuns(prev => ({ 
              ...prev, 
              [event.toolCallId]: { 
                name: event.name, 
                status: 'running',
                args: null,
                result: null
              } 
            }));
            break;
            
          case "TOOL_CALL_ARGS":
            setToolRuns(prev => ({ 
              ...prev, 
              [event.toolCallId]: { 
                ...prev[event.toolCallId], 
                args: event.args 
              } 
            }));
            break;
            
          case "TOOL_CALL_RESULT":
            setToolRuns(prev => ({ 
              ...prev, 
              [event.toolCallId]: { 
                ...prev[event.toolCallId], 
                result: event.result 
              } 
            }));
            break;
            
          case "TOOL_CALL_END":
            setToolRuns(prev => ({ 
              ...prev, 
              [event.toolCallId]: { 
                ...prev[event.toolCallId], 
                status: event.ok ? 'ok' : 'error' 
              } 
            }));
            break;

          case "STATE_DELTA":
            // Handle state changes if needed
            console.log('State delta:', event.ops);
            break;
            
          default:
            console.warn('Unknown event type:', event.type);
        }
      }
      
      setConnectionStatus('connected');
      
    } catch (err) {
      console.error('❌ Stream error:', err);
      setError(`Connection error: ${err.message}`);
      setConnectionStatus('disconnected');
      
      // Add error message to chat
      setMessages(prev => [...prev, { 
        role: 'assistant', 
        content: `Sorry, I encountered an error: ${err.message}. Please check if the backend server is running.`,
        messageId: `error_${Date.now()}`
      }]);
    } finally {
      setBusy(false);
    }
  };

  const handleKeyPress = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  };

  const getConnectionStatusColor = () => {
    switch (connectionStatus) {
      case 'connected': return '#28a745';
      case 'degraded': return '#ffc107';
      case 'disconnected': return '#dc3545';
      default: return '#6c757d';
    }
  };

  const getConnectionStatusText = () => {
    switch (connectionStatus) {
      case 'connected': return 'Connected';
      case 'degraded': return 'Degraded';
      case 'disconnected': return 'Disconnected';
      default: return 'Unknown';
    }
  };

  return (
    <div style={{ 
      minHeight: '100vh',
      background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
      padding: '20px'
    }}>
      <div style={{ 
        maxWidth: '900px', 
        margin: '0 auto',
        backgroundColor: 'white',
        borderRadius: '16px',
        boxShadow: '0 10px 30px rgba(0,0,0,0.2)',
        overflow: 'hidden'
      }}>
        {/* Header */}
        <div style={{ 
          padding: '24px',
          backgroundColor: '#2c3e50',
          color: 'white',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between'
        }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
            <div style={{ 
              fontSize: '32px',
              background: 'linear-gradient(45deg, #4CAF50, #2196F3)',
              borderRadius: '12px',
              width: '48px',
              height: '48px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center'
            }}>
              ✈️
            </div>
            <div>
              <h1 style={{ 
                margin: 0, 
                fontSize: '24px',
                fontWeight: '700'
              }}>
                FlightOps AG-UI
              </h1>
              <p style={{ 
                margin: 0, 
                fontSize: '14px',
                opacity: 0.8
              }}>
                Conversational Flight Data Analytics
              </p>
            </div>
          </div>
          
          <div style={{ 
            display: 'flex',
            alignItems: 'center',
            gap: '8px',
            backgroundColor: 'rgba(255,255,255,0.1)',
            padding: '8px 12px',
            borderRadius: '20px'
          }}>
            <div style={{
              width: '8px',
              height: '8px',
              borderRadius: '50%',
              backgroundColor: getConnectionStatusColor()
            }}></div>
            <span style={{ fontSize: '12px', fontWeight: '500' }}>
              {getConnectionStatusText()}
            </span>
          </div>
        </div>

        {/* Error Alert */}
        {error && (
          <div style={{ 
            padding: '12px 16px', 
            backgroundColor: '#f8d7da', 
            border: '1px solid #f5c6cb',
            color: '#721c24',
            display: 'flex',
            alignItems: 'center',
            gap: '8px'
          }}>
            <span>⚠️</span>
            <span>{error}</span>
          </div>
        )}

        {/* Main Content */}
        <div style={{ padding: '24px' }}>
          <Chat messages={messages} />
          
          <ToolStatus runs={toolRuns} />
          
          {/* Loading Indicator */}
          {busy && (
            <div style={{ 
              padding: '16px',
              textAlign: 'center',
              color: '#6c757d',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              gap: '8px'
            }}>
              <div style={{
                width: '16px',
                height: '16px',
                border: '2px solid #f3f3f3',
                borderTop: '2px solid #007bff',
                borderRadius: '50%',
                animation: 'spin 1s linear infinite'
              }}></div>
              <span>Processing your flight data query...</span>
            </div>
          )}

          {/* Input Area */}
          <div style={{ 
            display: 'flex', 
            gap: '12px', 
            marginTop: '24px',
            padding: '16px',
            backgroundColor: '#f8f9fa',
            borderRadius: '12px',
            border: '1px solid #e9ecef'
          }}>
            <input
              value={input}
              onChange={(e) => setInput(e.target.value)}
              placeholder="Ask about flight data, delays, equipment, analytics..."
              style={{ 
                flex: 1, 
                padding: '12px 16px',
                border: '1px solid #ced4da',
                borderRadius: '8px',
                fontSize: '16px',
                outline: 'none',
                transition: 'border-color 0.2s ease',
                backgroundColor: busy ? '#e9ecef' : 'white'
              }}
              onKeyPress={handleKeyPress}
              disabled={busy}
            />
            <button 
              onClick={sendMessage} 
              disabled={busy || !input.trim()} 
              style={{ 
                padding: '12px 24px',
                backgroundColor: busy ? '#6c757d' : 
                               !input.trim() ? '#6c757d' : '#007bff',
                color: 'white',
                border: 'none',
                borderRadius: '8px',
                fontSize: '16px',
                fontWeight: '600',
                cursor: (busy || !input.trim()) ? 'not-allowed' : 'pointer',
                transition: 'background-color 0.2s ease',
                display: 'flex',
                alignItems: 'center',
                gap: '8px'
              }}
            >
              {busy ? (
                <>
                  <div style={{
                    width: '12px',
                    height: '12px',
                    border: '2px solid transparent',
                    borderTop: '2px solid white',
                    borderRadius: '50%',
                    animation: 'spin 1s linear infinite'
                  }}></div>
                  Processing...
                </>
              ) : (
                <>
                  <span>🚀</span>
                  Send
                </>
              )}
            </button>
          </div>

          {/* Quick Suggestions */}
          <div style={{ marginTop: '16px' }}>
            <div style={{ 
              fontSize: '12px',
              color: '#6c757d',
              marginBottom: '8px',
              fontWeight: '600'
            }}>
              Try asking:
            </div>
            <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
              {[
                "Flight 6E 215 on 2024-06-23",
                "Delays for IndiGo flights",
                "Aircraft equipment for 6E 101",
                "Average passenger count"
              ].map((suggestion, index) => (
                <button
                  key={index}
                  onClick={() => setInput(suggestion)}
                  disabled={busy}
                  style={{
                    padding: '6px 12px',
                    backgroundColor: 'white',
                    border: '1px solid #dee2e6',
                    borderRadius: '16px',
                    fontSize: '12px',
                    color: '#495057',
                    cursor: busy ? 'not-allowed' : 'pointer',
                    transition: 'all 0.2s ease',
                    opacity: busy ? 0.6 : 1
                  }}
                >
                  {suggestion}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      {/* CSS Animation */}
      <style>{`
        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
      `}</style>
    </div>
  );
}
