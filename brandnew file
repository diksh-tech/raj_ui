import os
import json
import logging
import asyncio
from typing import Dict, Any, List, Optional
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse
from pydantic import BaseModel
import uuid
from datetime import datetime

# Import your existing MCP client
from app import FlightOpsMCPClient

app = FastAPI(title="FlightOps AG-UI API", version="1.0.0")

# CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173", "http://127.0.0.1:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("FlightOps.Backend")

class QueryRequest(BaseModel):
    query: str
    thread_id: Optional[str] = None
    run_id: Optional[str] = None

class ThreadManager:
    def __init__(self):
        self.active_threads: Dict[str, Any] = {}
        self.mcp_client = None
    
    async def initialize_client(self):
        if self.mcp_client is None:
            self.mcp_client = FlightOpsMCPClient()
            await self.mcp_client.connect()
    
    async def close_client(self):
        if self.mcp_client:
            await self.mcp_client.disconnect()

thread_manager = ThreadManager()

@app.on_event("startup")
async def startup_event():
    """Initialize MCP client on startup"""
    await thread_manager.initialize_client()
    logger.info("FlightOps AG-UI Backend started")

@app.on_event("shutdown")
async def shutdown_event():
    """Cleanup on shutdown"""
    await thread_manager.close_client()
    logger.info("FlightOps AG-UI Backend stopped")

def format_sse_event(event_type: str, data: Dict[str, Any]) -> str:
    """Format data as Server-Sent Event"""
    event_data = {
        "type": event_type,
        "data": data,
        "timestamp": datetime.now().isoformat()
    }
    return f"data: {json.dumps(event_data)}\n\n"

async def execute_query_stream(query: str, thread_id: str, run_id: str):
    """Execute query and stream events as SSE"""
    try:
        # Start event
        yield format_sse_event("run_start", {
            "thread_id": thread_id,
            "run_id": run_id,
            "query": query
        })

        # Plan generation event
        yield format_sse_event("plan_generation", {
            "status": "started",
            "message": "Generating execution plan..."
        })

        # Generate plan
        plan_data = thread_manager.mcp_client.plan_tools(query)
        plan = plan_data.get("plan", [])
        
        yield format_sse_event("plan_generation", {
            "status": "completed",
            "plan": plan,
            "message": f"Generated plan with {len(plan)} steps"
        })

        if not plan:
            yield format_sse_event("error", {
                "message": "No execution plan generated"
            })
            return

        results = []
        
        # Execute each tool in the plan
        for step_index, step in enumerate(plan):
            tool = step.get("tool")
            args = step.get("arguments", {})
            
            # Tool start event
            yield format_sse_event("tool_start", {
                "step": step_index + 1,
                "total_steps": len(plan),
                "tool": tool,
                "args": args
            })

            try:
                # Clean arguments
                args = {k: v for k, v in args.items() if v and str(v).strip().lower() != "unknown"}
                
                # Safety for MongoDB query
                if tool == "raw_mongodb_query":
                    query_json = args.get("query_json", "")
                    if not query_json:
                        result = {"error": "Empty query_json"}
                    else:
                        args["limit"] = int(args.get("limit", 50))
                        result = await thread_manager.mcp_client.invoke_tool(tool, args)
                else:
                    result = await thread_manager.mcp_client.invoke_tool(tool, args)
                
                results.append({tool: result})
                
                # Tool result event
                yield format_sse_event("tool_result", {
                    "step": step_index + 1,
                    "tool": tool,
                    "result": result,
                    "status": "completed"
                })
                
            except Exception as e:
                error_result = {"error": str(e)}
                results.append({tool: error_result})
                
                yield format_sse_event("tool_error", {
                    "step": step_index + 1,
                    "tool": tool,
                    "error": str(e)
                })

        # Generate summary
        yield format_sse_event("summary_generation", {
            "status": "started",
            "message": "Generating summary..."
        })

        try:
            summary = thread_manager.mcp_client.summarize_results(query, plan, results)
            
            yield format_sse_event("summary_generation", {
                "status": "completed",
                "summary": summary
            })
            
        except Exception as e:
            yield format_sse_event("summary_error", {
                "error": f"Summary generation failed: {str(e)}"
            })

        # Final result event
        yield format_sse_event("run_complete", {
            "thread_id": thread_id,
            "run_id": run_id,
            "plan": plan,
            "results": results,
            "summary": summary if 'summary' in locals() else None
        })

    except Exception as e:
        logger.error(f"Query execution failed: {str(e)}")
        yield format_sse_event("error", {
            "message": f"Query execution failed: {str(e)}"
        })

@app.post("/agent")
async def agent_stream(request: QueryRequest):
    """AG-UI compatible streaming endpoint"""
    thread_id = request.thread_id or f"thread-{uuid.uuid4().hex[:8]}"
    run_id = request.run_id or f"run-{uuid.uuid4().hex[:8]}"
    
    return StreamingResponse(
        execute_query_stream(request.query, thread_id, run_id),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "Connection": "keep-alive",
            "Access-Control-Allow-Origin": "*",
            "Access-Control-Allow-Headers": "*",
        }
    )

@app.post("/api/query")
async def query_non_streaming(request: QueryRequest):
    """Non-streaming endpoint for compatibility"""
    try:
        result = await thread_manager.mcp_client.run_query(request.query)
        return result
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/health")
async def health_check():
    """Health check endpoint"""
    return {
        "status": "healthy", 
        "service": "FlightOps AG-UI Backend",
        "timestamp": datetime.now().isoformat()
    }

@app.get("/tools")
async def list_tools():
    """List available tools"""
    try:
        tools = await thread_manager.mcp_client.list_tools()
        return tools
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8001, log_level="info")
