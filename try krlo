import os, json, logging
from dotenv import load_dotenv
from openai import AzureOpenAI
from mcp import ClientSession
from mcp.client.streamable_http import streamablehttp_client

from typing import Any, Dict, List
from tool_registry import TOOLS

load_dotenv()
logger = logging.getLogger("FlightOps.MCPClient")
logging.basicConfig(level=os.getenv("LOG_LEVEL", "INFO"))

MCP_SERVER_URL = os.getenv("MCP_SERVER_URL", "http://127.0.0.1:8000").rstrip("/")

AZURE_OPENAI_KEY = os.getenv("AZURE_OPENAI_KEY")
AZURE_OPENAI_ENDPOINT = os.getenv("AZURE_OPENAI_ENDPOINT")
AZURE_OPENAI_DEPLOYMENT = os.getenv("AZURE_OPENAI_DEPLOYMENT", "gpt-4o")
AZURE_API_VERSION = os.getenv("AZURE_API_VERSION", "2024-12-01-preview")

if not AZURE_OPENAI_KEY:
    raise RuntimeError("❌ AZURE_OPENAI_KEY not set")

client_azure = AzureOpenAI(
    api_key=AZURE_OPENAI_KEY,
    api_version=AZURE_API_VERSION,
    azure_endpoint=AZURE_OPENAI_ENDPOINT
)

def _build_tool_prompt() -> str:
    lines = []
    for name, meta in TOOLS.items():
        arg_str = ", ".join(meta["args"])
        lines.append(f"- {name}({arg_str}): {meta['desc']}")
    return "\n".join(lines)

SYSTEM_PROMPT_PLAN = f"""
You are an assistant that converts user questions into MCP tool calls.

Available tools:
{_build_tool_prompt()}

Rules:
- For counts/averages/sums/min/max → use run_aggregated_query with appropriate "field" and "query_type".
- For listings/filtering → use raw_mongodb_query with "query_json", "projection", "limit".
- For single-flight facts → use the specific flight tools (get_flight_basic_info, get_operation_times, get_equipment_info, get_delay_summary, get_fuel_summary, get_passenger_info, get_crew_info).
- Always return valid JSON with a top-level "plan" array.
- Never include "_id" in projections.
"""

SYSTEM_PROMPT_SUMMARIZE = """
You summarize tool outputs into a crisp, user-facing answer.
- Be factual and concise.
- Bullet points or short paragraphs.
"""

class FlightOpsMCPClient:
    def __init__(self, base_url: str = None):
        self.base_url = (base_url or MCP_SERVER_URL).rstrip("/")
        self.session: ClientSession | None = None
        self._client_context = None

    async def connect(self):
        logger.info(f"Connecting to MCP server at {self.base_url}")
        self._client_context = streamablehttp_client(self.base_url)
        read_stream, write_stream, _ = await self._client_context.__aenter__()
        self.session = ClientSession(read_stream, write_stream)
        await self.session.__aenter__()
        await self.session.initialize()
        logger.info("✅ Connected to MCP server")

    async def disconnect(self):
        try:
            if self.session:
                await self.session.__aexit__(None, None, None)
            if self._client_context:
                await self._client_context.__aexit__(None, None, None)
        except Exception as e:
            logger.error(f"Disconnect error: {e}")

    def _call_azure_openai(self, messages: list, temperature=0.2, max_tokens=1024) -> str:
        try:
            completion = client_azure.chat.completions.create(
                model=AZURE_OPENAI_DEPLOYMENT,
                messages=messages,
                temperature=temperature,
                max_tokens=max_tokens,
            )
            return completion.choices[0].message.content
        except Exception as e:
            logger.error(f"Azure OpenAI error: {e}")
            return ""

    async def list_tools(self) -> dict:
        if not self.session:
            await self.connect()
        tools_list = await self.session.list_tools()
        tools_dict = {t.name: {"description": t.description, "inputSchema": t.inputSchema} for t in tools_list.tools}
        return {"tools": tools_dict}

    async def invoke_tool(self, tool_name: str, args: dict) -> dict:
        if not self.session:
            await self.connect()
        logger.info(f"Calling tool {tool_name} args={args}")
        result = await self.session.call_tool(tool_name, args)
        if result.content:
            items = []
            for it in result.content:
                if hasattr(it, "text"):
                    try:
                        items.append(json.loads(it.text))
                    except json.JSONDecodeError:
                        items.append(it.text)
            return items[0] if len(items) == 1 else {"results": items}
        return {"error": "No content"}

    def plan_tools(self, user_query: str) -> dict:
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT_PLAN},
            {"role": "user", "content": user_query},
        ]
        content = (self._call_azure_openai(messages, temperature=0.1) or "").strip()
        if content.startswith("```"):
            cleaned = content.strip("`")
            if cleaned.lower().startswith("json"):
                cleaned = cleaned[4:].strip()
            cleaned = cleaned.replace("```", "").strip()
        else:
            cleaned = content
        try:
            plan = json.loads(cleaned)
            return plan if isinstance(plan, dict) and "plan" in plan else {"plan": []}
        except json.JSONDecodeError:
            logger.warning(f"Plan parse failed. Raw:\n{content}")
            return {"plan": []}

    def summarize_results(self, user_query: str, plan: list, results: list) -> str:
        messages = [
            {"role": "system", "content": SYSTEM_PROMPT_SUMMARIZE},
            {"role": "user", "content": f"Question:\n{user_query}"},
            {"role": "assistant", "content": f"Plan:\n{json.dumps(plan, indent=2)}"},
            {"role": "assistant", "content": f"Results:\n{json.dumps(results, indent=2)}"},
        ]
        summary = self._call_azure_openai(messages, temperature=0.3)
        return summary or ""
