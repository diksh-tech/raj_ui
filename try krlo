export default function ToolStatus({ runs }) {
  const ids = Object.keys(runs);
  if (!ids.length) return null;
  return (
    <div style={{ margin: "12px 0", padding: 12, border: "1px solid #eee" }}>
      <b>Tool Calls</b>
      {ids.map((id) => {
        const r = runs[id];
        return (
          <div key={id} style={{ fontSize: 14, marginTop: 6 }}>
            #{id.slice(0, 8)} {r.name} — {r.status || "running"}
            {r.args ? <div>args: <code>{JSON.stringify(r.args)}</code></div> : null}
            {r.result ? <div>result: <code>{JSON.stringify(r.result)}</code></div> : null}
          </div>
        );
      })}
    </div>
  );
}
