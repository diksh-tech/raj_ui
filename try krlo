import { useState } from "react";
import { aguiStream } from "./aguiClient";
import Chat from "./components/Chat";
import ToolStatus from "./components/ToolStatus";

const BACKEND_URL = "http://localhost:8001/agui/chat"; // change if needed

export default function App() {
  const [messages, setMessages] = useState([]);
  const [toolRuns, setToolRuns] = useState({});
  const [input, setInput] = useState("");
  const [busy, setBusy] = useState(false);

  const appendAssistantChunk = (messageId, chunk) => {
    const safeText = typeof chunk === "string" ? chunk : JSON.stringify(chunk, null, 2);
    setMessages((m) => {
      const copy = [...m];
      const idx = copy.findIndex(x => x.messageId === messageId && x.role === "assistant");
      if (idx === -1) copy.push({ role: "assistant", content: safeText, messageId });
      else copy[idx] = { ...copy[idx], content: (copy[idx].content || "") + safeText };
      return copy;
    });
  };

  const send = async () => {
    if (!input.trim() || busy) return;
    setBusy(true);
    const userMsg = { role: "user", content: input };
    setMessages((m) => [...m, userMsg]);
    setInput("");

    try {
      const payload = { messages: [...messages, userMsg], state: {} };
      for await (const ev of aguiStream(BACKEND_URL, payload)) {
        switch (ev.type) {
          case "TEXT_MESSAGE_START":
            setMessages((m) => [...m, { role: "assistant", content: "", messageId: ev.messageId }]);
            break;
          case "TEXT_MESSAGE_CONTENT":
            appendAssistantChunk(ev.messageId, ev.text || "");
            break;
          case "TEXT_MESSAGE_END":
            break;
          case "TOOL_CALL_START":
            setToolRuns((t) => ({ ...t, [ev.toolCallId]: { name: ev.name, status: "running" } }));
            break;
          case "TOOL_CALL_ARGS":
            setToolRuns((t) => ({ ...t, [ev.toolCallId]: { ...t[ev.toolCallId], args: ev.args } }));
            break;
          case "TOOL_CALL_RESULT":
            setToolRuns((t) => ({ ...t, [ev.toolCallId]: { ...t[ev.toolCallId], result: ev.result } }));
            break;
          case "TOOL_CALL_END":
            setToolRuns((t) => ({ ...t, [ev.toolCallId]: { ...t[ev.toolCallId], status: ev.ok ? "ok" : "error" } }));
            break;
          case "STATE_DELTA":
            // (optional) apply JSON Patch to local state
            break;
          default:
            break;
        }
      }
    } catch (e) {
      setMessages((m) => [...m, { role: "assistant", content: `Error: ${e.message}` }]);
    } finally {
      setBusy(false);
    }
  };

  return (
    <div style={{ maxWidth: 800, margin: "24px auto", fontFamily: "system-ui, sans-serif" }}>
      <h2>FlightOps — AG-UI (React)</h2>
      <Chat messages={messages} />
      <ToolStatus runs={toolRuns} />
      <div style={{ display: "flex", gap: 8, marginTop: 12 }}>
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          placeholder="Type your query…"
          style={{ flex: 1, padding: 8 }}
          onKeyDown={(e) => e.key === "Enter" && send()}
        />
        <button onClick={send} disabled={busy} style={{ padding: "8px 12px" }}>
          {busy ? "Working…" : "Send"}
        </button>
      </div>
    </div>
  );
}
